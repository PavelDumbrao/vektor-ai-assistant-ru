# === ОБЯЗАТЕЛЬНО ===
# Токен вашего телеграм-бота (получить у @BotFather — см. docs/01-telegram-bot.md)
TELEGRAM_BOT_TOKEN=ВСТАВЬТЕ_ТОКЕН_БОТА

# Кто может писать боту (ваш Telegram ID; узнать: напишите @userinfobot)
TELEGRAM_ALLOWED_USERS=ВАШ_TELEGRAM_ID

# Ключ LLM-провайдера (см. docs/02-llm-provider.md — три варианта, включая клубный ключ)
LLM_API_KEY=ВСТАВЬТЕ_КЛЮЧ

# === НЕОБЯЗАТЕЛЬНО ===
# Распознавание голосовых через OpenRouter (иначе локальный whisper)
#OPENROUTER_API_KEY=

# Премиум-голос MiniMax (иначе бесплатный edge-tts)
#MINIMAX_API_KEY=

# Maton: заполняется автоматически безопасной командой /maton в Telegram.
# Не вставляйте ключ обычным сообщением и не коммитьте его.
#MCP_MATON_API_KEY=

# Хук чистых документов (метаданные Word/PDF; см. AGENTS.md, шаг A5)
HERMES_DOC_WORKSPACE=ПУТЬ_К_РАБОЧЕМУ_КАТАЛОГУ
HERMES_DOC_AUTHOR=ВАШЕ_ИМЯ

# Сеть: не менять
HERMES_TELEGRAM_DISABLE_FALLBACK_IPS=1
