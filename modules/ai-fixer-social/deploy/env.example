TELEGRAM_BOT_TOKEN=<stored-in-secret-file>
TELEGRAM_CHANNEL_ID=<channel-id>
TELEGRAM_DISCUSSION_ID=<discussion-id>
TELEGRAM_CHANNEL_USERNAME=ProAiCommunity
TELEGRAM_BOT_USERNAME=<bot-username-without-at>
PAVEL_USER_ID=<owner-user-id>

LLM_BASE_URL=http://127.0.0.1:32779
LLM_API_KEY=<dedicated-virtual-key>
LLM_COMMENT_MODEL=gpt-5.4-mini

STATE_DB=/var/lib/ai-fixer-social/state.sqlite3
EDITORIAL_POLICY=/opt/ai-fixer-social/config/editorial-policy.md
COMMENT_MODE=shadow
BOOTSTRAP_SKIP_PENDING=true
MAX_REPLY_CHARS=600
MIN_REPLY_CONFIDENCE=0.88
MAX_REPLIES_PER_HOUR=10
MAX_REPLIES_PER_THREAD_HOUR=2
MAX_REPLIES_PER_DAY=40
USER_COOLDOWN_MINUTES=60
MAX_COMMENT_AGE_SECONDS=1800
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
