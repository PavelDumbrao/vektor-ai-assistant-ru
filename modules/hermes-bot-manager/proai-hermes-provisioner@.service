[Unit]
Description=Hermes Forge bounded provisioner for %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root by default. Do NOT set an explicit User=root here: combined with
# NoNewPrivileges= and the Protect*/LockPersonality sandbox, systemd strips CAP_SETUID
# from the service, and the provisioner must demote installers to the client uid.
# (Forge hiring failed with subprocess_failed:python3 / EPERM on setreuid, 2026-10-22.)
WorkingDirectory=/opt/proai-hermes-manager
ExecStart=/usr/bin/python3 /opt/proai-hermes-manager/provisioner.py provision --instance-file /opt/proai-hermes-manager/state/instances/%i.json
UMask=0077
TimeoutStartSec=600
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
