# Prodamus payment settings for Hermes Forge
# Place in /etc/proai-hermes-forge/billing.env with chmod 0600

# Form URL provided by Prodamus (e.g. https://<shop>.payform.ru/)
PRODAMUS_FORM_URL=https://<shop>.payform.ru/

# Secret key for HMAC signature verification
PRODAMUS_SECRET_KEY=<secret_key>

# Subscription plan details
FORGE_PLAN_NAME=Подписка Hermes Forge
FORGE_PLAN_PRICE_RUB=2000
FORGE_PLAN_DAYS=30

# Public base URL of Hermes Forge (used for webhook callback and return URLs)
FORGE_PUBLIC_URL=https://forge.example.com

# Optional: recurring subscription ID in Prodamus (if set, overrides products)
PRODAMUS_SUBSCRIPTION_ID=

# Optional: demo/test payment mode (1 to enable)
PRODAMUS_DEMO_MODE=0
