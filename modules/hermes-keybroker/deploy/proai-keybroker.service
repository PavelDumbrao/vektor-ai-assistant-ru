[Unit]
Description=ProAI key broker for Hermes client bots
After=network-online.target

[Service]
User=proai-keybroker
Group=proai-keybroker
EnvironmentFile=/etc/proai-hermes-platform.env
Environment=KEYBROKER_LANES=/etc/proai-keybroker/lanes.json KEYBROKER_ROUTES=/etc/proai-keybroker/routes.json KEYBROKER_STATE_DIR=/var/lib/proai-keybroker
ExecStart=/opt/proai-keybroker/.venv/bin/python -m keybroker
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=2
StateDirectory=proai-keybroker
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
