{
  "routes": [
    {"prefix": "/lingsuan/v1",      "upstream": "https://lingsuan.top/v1",      "kind": "openai",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "LLM_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/chat/completions$"}, {"methods": ["POST"], "path": "^/responses$"},
               {"methods": ["POST"], "path": "^/embeddings$"}, {"methods": ["GET"], "path": "^/models(/[^/]+)?$"}]},
    {"prefix": "/lingsuan-fb/v1",   "upstream": "https://lingsuan.top/v1",      "kind": "openai",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "FALLBACK_LLM_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/chat/completions$"}, {"methods": ["POST"], "path": "^/responses$"},
               {"methods": ["GET"], "path": "^/models(/[^/]+)?$"}]},
    {"prefix": "/lingsuan-opus/v1", "upstream": "https://api.lingsuan.si/v1",   "kind": "openai",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "LINGSUAN_OPUS_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/chat/completions$"}, {"methods": ["POST"], "path": "^/messages$"},
               {"methods": ["GET"], "path": "^/models(/[^/]+)?$"}]},
    {"prefix": "/unorouter/v1",     "upstream": "https://api.unorouter.com/v1", "kind": "openai",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "UNOROUTER_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/chat/completions$"}, {"methods": ["GET"], "path": "^/models(/[^/]+)?$"}]},
    {"prefix": "/gemini/v1",        "upstream": "https://lingsuan.top/v1",      "kind": "openai",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "GEMINI_LLM_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/chat/completions$"}, {"methods": ["GET"], "path": "^/models(/[^/]+)?$"}]},
    {"prefix": "/stt/v1",           "upstream": "https://openrouter.ai/api/v1", "kind": "stt",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "OPENROUTER_API_KEY"},
     "ladder": ["openai/whisper-large-v3-turbo", "microsoft/mai-transcribe-2", "openai/whisper-large-v3"],
     "allow": [{"methods": ["POST"], "path": "^/audio/transcriptions$"}]},
    {"prefix": "/elevenlabs",       "upstream": "https://api.elevenlabs.io",    "kind": "elevenlabs",
     "auth": {"header": "xi-api-key", "format": "{key}", "key_env": "ELEVENLABS_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/v1/text-to-speech/[A-Za-z0-9]+(/stream|/with-timestamps|/stream/with-timestamps)?$"},
               {"methods": ["GET"], "path": "^/v1/voices(/[A-Za-z0-9]+)?$"}, {"methods": ["GET"], "path": "^/v1/models$"}]},
    {"prefix": "/grsai",            "upstream": "https://grsaiapi.com",         "kind": "generic",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "GRSAI_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/v1/draw/completions$"}, {"methods": ["POST"], "path": "^/v1/draw/result$"}]},
    {"prefix": "/lingsuan-image",   "upstream": "https://lingsuan.top",         "kind": "generic",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "LLM_API_KEY"},
     "allow": [{"methods": ["POST"], "path": "^/v1/images/generations$"}]},
    {"prefix": "/saver/mcp",        "upstream": "https://saver-mcp.proaicommunity.online/mcp", "kind": "mcp",
     "auth": {"header": "Authorization", "format": "Bearer {key}", "key_env": "PROAISAVER_MCP_TOKEN"},
     "allow": [{"methods": ["POST", "GET", "DELETE"], "path": "^/?$"}]}
  ]
}
