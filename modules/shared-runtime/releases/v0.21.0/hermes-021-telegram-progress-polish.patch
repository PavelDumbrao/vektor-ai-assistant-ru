+@pytest.mark.asyncio
+async def test_real_tool_callback_has_friendly_status_without_arguments():
+    from gateway.run import TurnRunner
+    a = adapter()
+    c = consumer(a)
+    ctx = SimpleNamespace(stream_consumer_holder=[c],tool_progress_enabled=True,
+                          _run_still_current=lambda: True)
+    runner = TurnRunner(SimpleNamespace(),ctx)
+    task = asyncio.create_task(c.run())
+    await asyncio.wait_for(a.changed.wait(),3)
+    runner.progress_callback('tool.started','web_search',preview='PRIVATE_QUERY',
+                             args={'query':'PRIVATE_QUERY','key':'PRIVATE_KEY'})
+    await until(lambda: any('🔎 Ищу информацию' in f['content'] for f in a.frames))
+    runner.progress_callback('tool.completed','web_search')
+    await until(lambda: any('✍️ Готовлю ответ' in f['content'] for f in a.frames))
+    c.on_delta('Вот результат поиска.')
+    c.finish()
+    await task
+    assert all('PRIVATE_' not in f['content'] and 'web_search' not in f['content']
+               for f in a.frames)
+    assert a.send.call_args.kwargs['content']=='Вот результат поиска.'
+    assert len({f['draft_id'] for f in a.frames})==1
+
+
+@pytest.mark.asyncio
+async def test_activity_survives_buffered_text_until_new_delta():
+    a=adapter()
+    c=consumer(a)
+    c.on_delta('Смотрю материалы.')
+    task=asyncio.create_task(c.run())
+    await until(lambda: bool(a.frames))
+    c.on_tool_activity('tool.started','read_file')
+    await until(lambda: any('📖 Изучаю материалы' in f['content'] for f in a.frames))
+    assert a.frames[-1]['content'].startswith('Смотрю материалы.')
+    c.on_tool_activity('tool.completed','read_file')
+    await until(lambda: 'Готовлю ответ' in a.frames[-1]['content'])
+    c.on_delta(' Готово.')
+    c.finish()
+    await task
+    assert a.send.call_args.kwargs['content']=='Смотрю материалы. Готово.'
+
+
+def test_activity_duration_and_labels_are_compact():
+    c=consumer(adapter())
+    c._active_tool_names=['integration_connection_status']
+    assert c._format_waiting_status(8)=='**🔌 Проверяю подключение…** · 8 с'
+    assert c._format_waiting_status(65)=='**🔌 Проверяю подключение…** · 1:05'
+
