+@pytest.mark.asyncio
+async def test_pretool_preamble_stays_ephemeral_with_one_final():
+    a=adapter()
+    c=consumer(a)
+    c.on_delta('Сейчас проверю подключение.')
+    task=asyncio.create_task(c.run())
+    await until(lambda: bool(a.frames))
+    c.on_segment_break()
+    c.on_tool_activity('tool.started','integration_connection_status')
+    await until(lambda: any('Проверяю подключение' in f['content'] for f in a.frames))
+    c.on_tool_activity('tool.completed','integration_connection_status')
+    c.on_delta('Подключение исправно.')
+    c.finish(final_text='Подключение исправно.')
+    await task
+    a.send.assert_awaited_once()
+    assert a.send.call_args.kwargs['content']=='Подключение исправно.'
+    assert len({f['draft_id'] for f in a.frames})==1

