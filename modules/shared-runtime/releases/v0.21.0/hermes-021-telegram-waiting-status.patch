+"""Behavior checks for optional Telegram waiting labels and final delivery."""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from gateway.platforms.base import BasePlatformAdapter, SendResult
+from gateway.stream_consumer import GatewayStreamConsumer, StreamConsumerConfig
+
+
+def adapter(drafts=True, reject_draft=False):
+    cls = type('WaitingAdapter', (BasePlatformAdapter,), {'MAX_MESSAGE_LENGTH': 4096})
+    cls.__abstractmethods__ = frozenset()
+    a = cls.__new__(cls)
+    a._typing_paused = set()
+    a._fatal_error_message = None
+    a.frames = []
+    a.changed = asyncio.Event()
+    a.supports_draft_streaming = lambda **kw: drafts
+    async def frame(**kw):
+        a.frames.append(kw)
+        a.changed.set()
+        return SendResult(success=not reject_draft, error='rejected' if reject_draft else None)
+    a.send_draft = frame
+    a.send = AsyncMock(return_value=SimpleNamespace(success=True, message_id='real'))
+    a.edit_message = AsyncMock(return_value=SimpleNamespace(success=True))
+    a.delete_message = AsyncMock(return_value=True)
+    return a
+
+
+def consumer(a, thread='11', **kw):
+    cfg = dict(transport='auto', chat_type='dm', cursor='', edit_interval=.01,
+               waiting_status_enabled=True, waiting_status_initial_delay=0,
+               waiting_status_update_interval=2, buffer_threshold=1)
+    cfg.update(kw)
+    return GatewayStreamConsumer(a, '123', StreamConsumerConfig(**cfg),
+                                 metadata={'thread_id': thread}, initial_reply_to_id='99')
+
+
+async def until(predicate):
+    async def wait():
+        while not predicate():
+            await asyncio.sleep(.01)
+    await asyncio.wait_for(wait(), 3)
+
+
+@pytest.mark.asyncio
+async def test_waiting_replaced_by_text_same_draft_then_one_real_final():
+    a = adapter()
+    c = consumer(a)
+    task = asyncio.create_task(c.run())
+    await asyncio.wait_for(a.changed.wait(), 3)
+    assert 'Думаю' in a.frames[0]['content']
+    c.on_delta('Первый ответ')
+    await until(lambda: any(f['content'] == 'Первый ответ' for f in a.frames))
+    c.finish(final_text='Первый ответ. Готово.')
+    await task
+    assert len({f['draft_id'] for f in a.frames}) == 1
+    assert all(f['metadata']['thread_id'] == '11' for f in a.frames)
+    a.send.assert_awaited_once()
+    assert a.send.call_args.kwargs['content'] == 'Первый ответ. Готово.'
+    assert c.delivered_final_matches('Первый ответ. Готово.') is True
+    assert c._waiting_status_suspended is True
+
+
+@pytest.mark.asyncio
+async def test_fast_turn_has_no_waiting_flash():
+    a = adapter()
+    c = consumer(a, waiting_status_initial_delay=.45)
+    c.on_delta('Готово')
+    c.finish(final_text='Готово')
+    await c.run()
+    assert not a.frames
+    a.send.assert_awaited_once()
+    assert a.send.call_args.kwargs['content'] == 'Готово'
+
+
+@pytest.mark.asyncio
+async def test_draft_rejection_falls_back_to_one_editable_message():
+    a = adapter(reject_draft=True)
+    c = consumer(a)
+    task = asyncio.create_task(c.run())
+    await until(lambda: a.send.await_count == 1)
+    c.on_delta('Ответ после отказа draft')
+    c.finish()
+    await task
+    a.send.assert_awaited_once()
+    assert a.edit_message.call_args.kwargs['content'] == 'Ответ после отказа draft'
+    assert c.final_content_delivered
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('end', ['cancel', 'empty', 'stale'])
+async def test_waiting_only_edit_preview_removed_on_turn_end(end):
+    a = adapter(drafts=False)
+    c = consumer(a)
+    task = asyncio.create_task(c.run())
+    await until(lambda: a.send.await_count == 1)
+    if end == 'cancel':
+        task.cancel()
+    elif end == 'empty':
+        c.finish()
+    else:
+        c._run_still_current = lambda: False
+    await task
+    a.delete_message.assert_awaited_once_with('123', 'real')
+    assert not c.final_response_sent
+    assert not c.final_content_delivered
+
+
+@pytest.mark.asyncio
+async def test_independent_topics_have_distinct_draft_ids_and_routing():
+    a = adapter()
+    consumers = [consumer(a, thread='11'), consumer(a, thread='22')]
+    tasks = [asyncio.create_task(c.run()) for c in consumers]
+    await until(lambda: len(a.frames) >= 2)
+    for n,c in enumerate(consumers):
+        c.on_delta(f'Ответ {n}')
+        c.finish()
+    await asyncio.gather(*tasks)
+    routes = {(f['draft_id'], f['metadata']['thread_id']) for f in a.frames}
+    assert len(routes) == 2
+    assert len({r[0] for r in routes}) == 2
+    assert {r[1] for r in routes} == {'11', '22'}
