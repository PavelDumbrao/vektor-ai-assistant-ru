+    grant: Any,
+    approval_key: str,
+    owner_id: str,
+    business_connection_id: str,
+    chat_id: int,
+    text: str,
+    reply_message_id: Optional[int] = None,
+) -> BusinessReplyResult:
+    """Consume one exact grant and bridge the send onto the gateway loop."""
+    try:
+        from tools.approval import (
+            consume_one_time_approval_grant,
+            get_current_session_key,
+        )
+    except Exception:
+        return BusinessReplyResult(
+            status="failed_known", error_code="approval_bridge_unavailable"
+        )
+
+    session_key = get_current_session_key(default="")
+    try:
+        if isinstance(owner_id, bool):
+            raise ValueError
+        parsed_owner_id = int(owner_id)
+    except (TypeError, ValueError, OverflowError):
+        parsed_owner_id = 0
+    if (
+        not session_key
+        or parsed_owner_id <= 0
+        or not isinstance(approval_key, str)
+        or not approval_key
+        or len(approval_key) > 512
+        or any(char.isspace() or ord(char) < 0x20 for char in approval_key)
+        or not isinstance(business_connection_id, str)
+        or not business_connection_id
+        or business_connection_id != business_connection_id.strip()
+        or len(business_connection_id) > 512
+        or any(ord(char) < 0x20 for char in business_connection_id)
+        or isinstance(chat_id, bool)
+        or not isinstance(chat_id, int)
+        or chat_id <= 0
+        or not isinstance(text, str)
+        or not text
+        or "\x00" in text
+        or (
+            reply_message_id is not None
+            and (
+                isinstance(reply_message_id, bool)
+                or not isinstance(reply_message_id, int)
+                or reply_message_id <= 0
+            )
+        )
+    ):
+        return BusinessReplyResult(
+            status="failed_known", error_code="invalid_bridge_arguments"
+        )
+
+    with _BUSINESS_REPLY_BINDINGS_LOCK:
+        binding = _BUSINESS_REPLY_BINDINGS.get(session_key)
+    if binding is None or binding.owner_id != parsed_owner_id:
+        return BusinessReplyResult(
+            status="failed_known", error_code="owner_session_not_bound"
+        )
+    if binding.loop.is_closed() or not binding.loop.is_running():
+        return BusinessReplyResult(
+            status="failed_known", error_code="gateway_loop_unavailable"
+        )
+    try:
+        if asyncio.get_running_loop() is binding.loop:
+            return BusinessReplyResult(
+                status="failed_known", error_code="gateway_loop_reentry"
+            )
+    except RuntimeError:
+        pass
+
+    if not consume_one_time_approval_grant(
+        grant,
+        tool_name="passive_secretary_reply",
+        approval_key=approval_key,
+    ):
+        return BusinessReplyResult(
+            status="failed_known", error_code="approval_grant_invalid"
+        )
+
+    try:
+        future = asyncio.run_coroutine_threadsafe(
+            binding.adapter.send_business_reply(
+                owner_id=parsed_owner_id,
+                business_connection_id=business_connection_id,
+                chat_id=chat_id,
+                text=text,
+                reply_message_id=reply_message_id,
+            ),
+            binding.loop,
+        )
+    except Exception:
+        return BusinessReplyResult(
+            status="failed_known", error_code="send_schedule_failed"
+        )
+
+    try:
+        result = future.result(timeout=_BUSINESS_REPLY_BRIDGE_TIMEOUT_SECONDS)
+    except concurrent.futures.TimeoutError:
+        # Cancellation cannot prove whether Telegram received the request.
+        # Leave the coroutine alone and force an ambiguous terminal state.
+        return BusinessReplyResult(
+            status="ambiguous", error_code="send_bridge_timeout"
+        )
+    except Exception:
+        return BusinessReplyResult(
+            status="ambiguous", error_code="send_bridge_exception"
+        )
+    if not isinstance(result, BusinessReplyResult):
+        return BusinessReplyResult(
+            status="ambiguous", error_code="invalid_bridge_result"
+        )
+    if result.status not in {"sent", "failed_known", "ambiguous"}:
+        return BusinessReplyResult(
+            status="ambiguous", error_code="invalid_bridge_result"
+        )
+    return result
+
