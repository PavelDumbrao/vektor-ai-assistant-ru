+            bool(getattr(ctx, "session_id", None)),
+            str(getattr(ctx, "session_key", "") or "") == str(getattr(ctx, "session_id", "") or ""),
+        )
+        if not _identity_trusted:
+            return None
+        bindings: list[tuple[str, object]] = []
+        for binding_key in dict.fromkeys(
+            key
+            for key in (
+                str(ctx.session_key or ""),
+                str(getattr(ctx, "session_id", "") or ""),
+                str(agent_session_id or ""),
+            )
+            if key
+        ):
+            binding_token = bind_passive_identity_capability(
+                binding_key,
+                owner_id=owner_id,
+                owner_chat_id=owner_chat_id,
+                adapter=adapter,
+                loop=loop,
+            )
+            logger.info(
+                "Passive identity binding diagnostic3: alias_kind=%s bound=%s",
+                (
+                    "gateway"
+                    if binding_key == str(ctx.session_key or "")
+                    else "ctx"
+                    if binding_key == str(getattr(ctx, "session_id", "") or "")
+                    else "agent"
+                ),
+                binding_token is not None,
+            )
+            if binding_token is not None:
+                bindings.append((binding_key, binding_token))
+    except Exception:
+        logger.warning(
+            "Telegram passive identity capability could not be bound",
+            exc_info=True,
+        )
