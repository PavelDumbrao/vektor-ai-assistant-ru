+                not stat.S_ISREG(info.st_mode)
+                or info.st_nlink != 1
+                or stat.S_IMODE(info.st_mode) & 0o077
+            ):
+                raise RuntimeError("Telegram passive group registry lock is unsafe")
+            if created:
+                os.fsync(fd)
+                DurableUpdateSpool._fsync_directory(self.path.parent)
