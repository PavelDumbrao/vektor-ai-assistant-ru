+    update = SimpleNamespace(update_id=909, business_message=SimpleNamespace(
+        business_connection_id='upgrade-synthetic', chat=SimpleNamespace(type='private')))
+    for value in (connection({}, owner=999), connection({}, enabled=False)):
+        current._bot.get_business_connection.return_value = value
+        assert await current._authorize_business_update_with_recovery(update) == (None, None)
+    result = await current.send_business_reply(owner_id=123, business_connection_id='upgrade-synthetic',
+                                              chat_id=456, text='Never transmitted')
+    assert result.error_code == 'business_reply_disabled'
+    current._bot.send_message.assert_not_called()
+
