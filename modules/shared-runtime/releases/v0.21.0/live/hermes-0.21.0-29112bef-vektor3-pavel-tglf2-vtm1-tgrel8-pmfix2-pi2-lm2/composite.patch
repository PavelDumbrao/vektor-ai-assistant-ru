+    @staticmethod
+    def _business_connection_is_receive_only(connection: Any) -> bool:
+        """Accept only Business connections with every Telegram right disabled."""
+        _, rights_valid, receive_only, _reply_only = business_connection_rights_state(
+            getattr(connection, "rights", None)
+        )
+        return rights_valid and receive_only
+
+    def _business_connection_capture_authorized(self, connection: Any) -> bool:
+        """Validate metadata without coupling incoming capture to action rights."""
+        _, rights_valid, _receive_only, _reply_only = business_connection_rights_state(
+            getattr(connection, "rights", None)
+        )
+        return rights_valid
+
+    async def send_business_reply(
+        self,
+        *,
+        owner_id: int,
+        business_connection_id: str,
+        chat_id: int,
+        text: str,
+        reply_message_id: Optional[int] = None,
+    ) -> BusinessReplyResult:
+        """Send one exact Business reply after a fresh live rights check.
+
+        This method is intentionally absent from the platform tool registry.
+        The module-level bridge below is the only supported caller and binds it
+        to the active owner session plus an atomically consumed approval grant.
+        Failures before ``send_message`` are known non-sends; once that method
+        is invoked, any exception or invalid receipt is ambiguous and must not
+        be retried automatically.
+        """
+        if (
+            isinstance(owner_id, bool)
+            or not isinstance(owner_id, int)
+            or owner_id <= 0
+            or isinstance(chat_id, bool)
+            or not isinstance(chat_id, int)
+            or chat_id <= 0
+            or not isinstance(business_connection_id, str)
+            or not business_connection_id
+            or business_connection_id != business_connection_id.strip()
+            or len(business_connection_id) > 512
+            or any(ord(char) < 0x20 for char in business_connection_id)
+            or not isinstance(text, str)
+            or not text
+            or "\x00" in text
+            or utf16_len(text) > self.MAX_MESSAGE_LENGTH
+            or (
+                reply_message_id is not None
+                and (
+                    isinstance(reply_message_id, bool)
+                    or not isinstance(reply_message_id, int)
+                    or reply_message_id <= 0
+                )
+            )
+        ):
+            return BusinessReplyResult(
+                status="failed_known", error_code="invalid_send_arguments"
+            )
+
+        try:
+            if self._business_updates_mode() != "passive":
+                return BusinessReplyResult(
+                    status="failed_known", error_code="passive_mode_required"
+                )
+            if not self._business_reply_enabled():
+                return BusinessReplyResult(
+                    status="failed_known", error_code="business_reply_disabled"
+                )
+            if owner_id not in self._business_owner_ids():
+                return BusinessReplyResult(
+                    status="failed_known", error_code="owner_not_allowed"
+                )
+        except Exception:
+            return BusinessReplyResult(
+                status="failed_known", error_code="business_reply_config_invalid"
+            )
+
+        bot = self._bot
+        if bot is None:
+            return BusinessReplyResult(
+                status="failed_known", error_code="telegram_not_connected"
+            )
+        getter = getattr(bot, "get_business_connection", None)
+        if not callable(getter):
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_check_unavailable"
+            )
+
+        try:
+            connection = await asyncio.wait_for(
+                getter(
+                    business_connection_id,
+                    read_timeout=8.0,
+                    connect_timeout=5.0,
+                    pool_timeout=5.0,
+                ),
+                timeout=12.0,
+            )
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning(
+                "[%s] Telegram Business reply preflight failed (%s)",
+                self.name,
+                type(exc).__name__,
+            )
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_check_failed"
+            )
+
+        live_connection_id = str(getattr(connection, "id", "") or "")
+        if live_connection_id != business_connection_id:
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_mismatch"
+            )
+        if getattr(connection, "is_enabled", None) is not True:
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_disabled"
+            )
+        try:
+            live_owner_id = int(
+                getattr(getattr(connection, "user", None), "id", 0) or 0
+            )
+        except (TypeError, ValueError, OverflowError):
+            live_owner_id = 0
+        if live_owner_id != owner_id:
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_owner_mismatch"
+            )
+        _rights, rights_valid, _receive_only, reply_only = (
+            business_connection_rights_state(getattr(connection, "rights", None))
+        )
+        if not rights_valid or not reply_only:
+            return BusinessReplyResult(
+                status="failed_known", error_code="business_reply_rights_invalid"
+            )
+
+        send_kwargs: Dict[str, Any] = {
+            "chat_id": chat_id,
+            "text": text,
+            "business_connection_id": business_connection_id,
+            "read_timeout": 10.0,
+            "write_timeout": 10.0,
+            "connect_timeout": 5.0,
+            "pool_timeout": 5.0,
+        }
+        if reply_message_id is not None:
+            send_kwargs["reply_parameters"] = ReplyParameters(
+                message_id=reply_message_id,
+                allow_sending_without_reply=False,
+            )
+
+        try:
+            message = await bot.send_message(**send_kwargs)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning(
+                "[%s] Telegram Business reply send outcome is ambiguous (%s)",
+                self.name,
+                type(exc).__name__,
+            )
+            return BusinessReplyResult(
+                status="ambiguous", error_code="telegram_send_exception"
+            )
+
+        message_id = getattr(message, "message_id", None)
+        if (
+            isinstance(message_id, bool)
+            or not isinstance(message_id, int)
+            or message_id <= 0
+        ):
+            return BusinessReplyResult(
+                status="ambiguous", error_code="invalid_send_receipt"
+            )
+        return BusinessReplyResult(status="sent", message_id=message_id)
+
+    def _authorize_business_update(self, update: Update) -> int | None:
+        """Resolve an allowlisted Business owner before persisting any chat PII."""
+        allowed = self._business_owner_ids()
+        kind = business_update_kind(update)
+        registry = self._get_passive_connection_registry()
+        if kind == "business_connection":
+            connection = update.business_connection
+            connection_id = str(getattr(connection, "id", "") or "").strip()
+            registry.mark_existing_untrusted(
+                connection_id,
+                int(getattr(update, "update_id", -1)),
+            )
+            owner_id = getattr(getattr(connection, "user", None), "id", None)
+            try:
+                owner_id = int(owner_id)
+            except (TypeError, ValueError, OverflowError):
+                return None
+            if owner_id not in allowed or not connection_id:
+                logger.warning(
+                    "[%s] Ignoring Telegram Business connection outside owner allowlist",
+                    self.name,
+                )
+                return None
+            enabled = getattr(connection, "is_enabled", None) is True
+            capture_authorized = self._business_connection_capture_authorized(
+                connection
+            )
+            registry.update(
+                connection_id,
+                owner_id,
+                enabled=enabled and capture_authorized,
+                update_id=int(getattr(update, "update_id", -1)),
+            )
+            if enabled and not capture_authorized:
+                logger.error(
+                    "[%s] Telegram Business connection rights metadata is invalid; "
+                    "message capture remains disabled",
+                    self.name,
+                )
+            return owner_id
+
+        source = (
+            update.deleted_business_messages
+            if kind == "deleted_business_messages"
+            else getattr(update, kind)
+        )
+        chat_type = str(getattr(getattr(source, "chat", None), "type", "") or "")
+        if chat_type != "private":
+            logger.warning(
+                "[%s] Ignoring non-private Telegram Business update: kind=%s update_id=%s",
+                self.name,
+                kind,
+                getattr(update, "update_id", None),
+            )
+            return None
+        connection_id = str(
+            getattr(source, "business_connection_id", "") or ""
+        ).strip()
+        owner_id = registry.owner_for(connection_id) if connection_id else None
+        if owner_id not in allowed:
+            logger.warning(
+                "[%s] Ignoring Telegram Business update for an unknown connection: "
+                "kind=%s update_id=%s",
+                self.name,
+                kind,
+                getattr(update, "update_id", None),
+            )
+            return None
+        return owner_id
+
+    async def _authorize_business_update_with_recovery(
+        self, update: Update
+    ) -> tuple[int | None, dict[str, Any] | None]:
+        """Resolve an owner and hydrate every message from authoritative state.
+
+        Telegram explicitly recommends ``getBusinessConnection`` when a bot
+        receives message updates before it has cached the corresponding
+        connection event.  The same live check is required while the local
+        registry is warm: registry durability is not proof that the downstream
+        PostgreSQL connection row committed.  Only the opaque connection id is
+        sent to Telegram; message content is not persisted until the returned
+        owner passes the deployment allowlist.  Lifecycle DTOs remain unchanged.
+        """
+        kind = business_update_kind(update)
+        if kind == "business_connection":
+            return self._authorize_business_update(update), None
+
+        source = (
+            update.deleted_business_messages
+            if kind == "deleted_business_messages"
+            else getattr(update, kind)
+        )
+        # This is a definitive scope rejection, not a cache miss. Never make a
+        # live capability query for a non-private payload.
+        chat_type = str(getattr(getattr(source, "chat", None), "type", "") or "")
+        if chat_type != "private":
+            logger.warning(
+                "[%s] Ignoring non-private Telegram Business update: "
+                "kind=%s update_id=%s",
+                self.name,
+                kind,
+                getattr(update, "update_id", None),
+            )
+            return None, None
+        connection_id = str(
+            getattr(source, "business_connection_id", "") or ""
+        ).strip()
+        getter = getattr(self._bot, "get_business_connection", None)
+        if not connection_id:
+            return None, None
+        if not callable(getter):
+            raise RuntimeError(
+                "Telegram Business connection recovery is temporarily unavailable"
+            )
+        try:
+            connection = await asyncio.wait_for(
+                getter(
+                    connection_id,
+                    read_timeout=8.0,
+                    connect_timeout=5.0,
+                    pool_timeout=5.0,
+                ),
+                timeout=12.0,
+            )
+            recovered_owner = int(
+                getattr(getattr(connection, "user", None), "id", 0) or 0
+            )
+            recovered_enabled = getattr(connection, "is_enabled", None) is True
+            recovered_capture_authorized = self._business_connection_capture_authorized(
+                connection
+            )
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning(
+                "[%s] Could not recover Telegram Business connection metadata; "
+                "durable ingress will retry (%s)",
+                self.name,
+                type(exc).__name__,
+            )
+            raise RuntimeError(
+                "Telegram Business connection recovery failed"
+            ) from exc
+        if not recovered_enabled:
+            logger.warning(
+                "[%s] Rejected disabled Telegram Business connection during recovery",
+                self.name,
+            )
+            return None, None
+        if not recovered_capture_authorized:
+            logger.error(
+                "[%s] Rejected Telegram Business connection with invalid "
+                "rights metadata during recovery",
+                self.name,
+            )
+            return None, None
+        if recovered_owner not in self._business_owner_ids():
+            logger.warning(
+                "[%s] Rejected recovered Telegram Business connection outside owner allowlist",
+                self.name,
+            )
+            return None, None
+        try:
+            connection_snapshot = normalize_recovered_business_connection_snapshot(
+                connection,
+                expected_connection_id=connection_id,
+                tenant_owner_id=recovered_owner,
+                business_reply_enabled=self._business_reply_enabled(),
+            )
+        except ValueError as exc:
+            logger.error(
+                "[%s] Rejected malformed Telegram Business connection recovery: %s",
+                self.name,
+                str(exc),
+            )
+            return None, None
+        accepted = self._get_passive_connection_registry().recover_current(
+            connection_id,
+            recovered_owner,
+            enabled=True,
+            observed_update_id=int(getattr(update, "update_id", -1)),
+        )
+        if not accepted:
+            return None, None
+        return recovered_owner, connection_snapshot
+
+    async def _ingest_passive_business_update_once(self, update: Update) -> bool:
+        """Persist one authorized Business update, or reject it definitively.
+
+        ``False`` means the update is safely outside the configured capture
+        scope. Exceptions mean the decision or fsync is indeterminate and the
+        Telegram offset must not advance.
+        """
+        owner_id, connection_snapshot = (
+            await self._authorize_business_update_with_recovery(update)
+        )
+        if owner_id is None:
+            return False
+        event = build_business_update_dto(
+            update,
+            tenant_owner_id=owner_id,
+            business_reply_enabled=self._business_reply_enabled(),
+            connection_snapshot=connection_snapshot,
+        )
+        self._get_passive_update_spool().put(event)
+        self._passive_spool_wakeup.set()
+        return True
+
+    async def _durably_ingest_business_update_before_ack(
+        self, update: Update
+    ) -> None:
+        """Hold PTB's acknowledgement boundary until local durability exists.
+
+        The retry loop intentionally lives inside ``Queue.put``. PTB only
+        catches Telegram transport exceptions around polling; leaking a local
+        disk/registry exception would kill its polling task while leaving the
+        updater marked running. Cancellation is the sole exception: shutdown
+        cancels this await and Telegram then redelivers from the old offset.
+        """
+        attempt = 0
+        self._passive_ingress_blocked = True
+        try:
+            while True:
+                try:
+                    await self._ingest_passive_business_update_once(update)
+                    return
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    attempt += 1
+                    if attempt == 1 or attempt & (attempt - 1) == 0:
+                        logger.critical(
+                            "[%s] Telegram Business durable ingress is blocked; "
+                            "offset not acknowledged, retry=%d kind=%s update_id=%s "
+                            "failure=%s",
+                            self.name,
+                            attempt,
+                            self._safe_business_update_kind(update),
+                            getattr(update, "update_id", None),
+                            type(exc).__name__,
+                        )
+                    await asyncio.sleep(
+                        self._passive_ingress_retry_delay_seconds(attempt)
+                    )
+        finally:
+            self._passive_ingress_blocked = False
+
+    async def _route_update_through_durable_ingress(self, item: object) -> None:
+        """Queue callback for an item identified as passive Business/group data."""
+        if self._ordinary_group_message(item) is not None:
+            await self._durably_ingest_group_update_before_ack(item)
+            return
+        await self._durably_ingest_business_update_before_ack(item)  # type: ignore[arg-type]
+
+    async def _ingest_passive_group_update_once(self, update: Update) -> bool:
+        message = self._ordinary_group_message(update)
+        if message is None:
+            return False
+        chat_id = int(getattr(getattr(message, "chat", None), "id", 0) or 0)
+        if chat_id not in self._group_passive_chat_ids():
+            return False
+        sender = getattr(message, "from_user", None)
+        if getattr(sender, "is_bot", False) is True:
+            return False
+        event = build_group_passive_update_dto(
+            update,
+            tenant_owner_id=self._group_passive_owner_id(),
+        )
+        self._get_passive_update_spool().put(event)
+        self._passive_spool_wakeup.set()
+        return True
+
+    async def _durably_ingest_group_update_before_ack(self, update: Update) -> None:
+        attempt = 0
+        self._passive_ingress_blocked = True
+        try:
+            while True:
+                try:
+                    await self._ingest_passive_group_update_once(update)
+                    return
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    attempt += 1
+                    if attempt == 1 or attempt & (attempt - 1) == 0:
+                        logger.critical(
+                            "[%s] Telegram group durable ingress blocked; offset not "
+                            "acknowledged retry=%d update_id=%s failure=%s",
+                            self.name, attempt, getattr(update, "update_id", None),
+                            type(exc).__name__,
+                        )
+                    await asyncio.sleep(self._passive_ingress_retry_delay_seconds(attempt))
+        finally:
+            self._passive_ingress_blocked = False
+
+    def _dispatch_passive_event(self, event: dict[str, Any]) -> bool:
+        """Offer one durable DTO to plugins and acknowledge only after commit."""
+        from hermes_cli.lifecycle import invoke_hook as _invoke_hook
+
+        raw_results = _invoke_hook("telegram_passive_update", event=event)
+        hook_results = raw_results if isinstance(raw_results, (list, tuple)) else []
+        acknowledged = any(
+            isinstance(result, dict) and result.get("handled") is True
+            for result in hook_results
+        )
+        if acknowledged:
+            if (
+                self._passive_media_enabled()
+                and event.get("kind")
+                in {
+                    "business_message", "edited_business_message",
+                    "group_message", "edited_group_message",
+                }
+            ):
+                # This is part of the raw-spool ACK barrier.  A plugin/PG
+                # commit is not enough for media messages: the private job
+                # (the only durable copy retaining file_id) must also fsync.
+                self._get_passive_media_spool().stage_event(
+                    event,
+                    bot_id=self._passive_media_bot_id(),
+                    processor_version=self._passive_media_processor_version(),
+                )
+            self._get_passive_update_spool().acknowledge(event)
+            return True
+        logger.critical(
+            "[%s] Telegram passive update is durable but collector did not "
+            "acknowledge it: kind=%s update_id=%s",
+            self.name,
+            event.get("kind"),
+            event.get("update_id"),
+        )
+        return False
+
+    def _drain_passive_update_spool(self) -> int:
+        drained = 0
+        for event in self._get_passive_update_spool().pending(limit=250):
+            try:
+                if not self._dispatch_passive_event(event):
+                    break
+                drained += 1
+            except Exception as exc:
+                logger.error(
+                    "[%s] Telegram passive replay failed; pending data retained (%s)",
+                    self.name,
+                    type(exc).__name__,
+                )
+                break
+        return drained
+
+    async def _passive_spool_retry_loop(self) -> None:
+        interval = self._coerce_float_extra(
+            "passive_retry_seconds", 30.0, min_value=5.0, max_value=3600.0
+        )
+        try:
+            while True:
+                self._passive_spool_wakeup.clear()
+                # PostgreSQL/plugin work is deliberately kept off PTB's event
+                # loop. Telegram can continue polling once the local fsync
+                # spool has accepted an event.
+                try:
+                    await asyncio.to_thread(self._drain_passive_update_spool)
+                except Exception as exc:
+                    logger.error(
+                        "[%s] Telegram passive replay loop failed; retrying later (%s)",
+                        self.name,
+                        type(exc).__name__,
+                    )
+                try:
+                    await asyncio.wait_for(
+                        self._passive_spool_wakeup.wait(), timeout=interval
+                    )
+                except asyncio.TimeoutError:
+                    pass
+        except asyncio.CancelledError:
+            raise
+
+    def _start_passive_spool_retry(self) -> None:
+        if (
+            self._business_updates_mode() != "passive"
+            and not self._group_passive_enabled()
+        ):
+            return
+        task = self._passive_spool_retry_task
+        if task and not task.done():
+            return
+        self._passive_spool_retry_task = asyncio.ensure_future(
+            self._passive_spool_retry_loop()
+        )
+
+    def _passive_media_processor_identity(self) -> dict[str, str]:
+        if self._passive_media_asr_provider() == "openrouter":
+            return {
+                "service": "openrouter",
+                "version": "v1",
+                "engine": "openrouter-stt",
+                "model": "openai/whisper-large-v3-turbo",
+                "quantization": "provider-managed",
+            }
+        return {
+            "service": "whisper-asr-webservice",
+            "version": "1.9.1",
+            "engine": "faster-whisper",
+            "model": "small",
+            "quantization": "int8",
+        }
+
+    @staticmethod
+    def _passive_media_download_is_permanent(error: BaseException) -> bool:
+        try:
+            from telegram.error import BadRequest
+
+            return isinstance(error, BadRequest)
+        except ImportError:
+            return False
+
+    def _dispatch_passive_media_result(self, event: dict[str, Any]) -> bool:
+        """Commit one capability-free media result through the existing hook."""
+        from hermes_cli.lifecycle import invoke_hook as _invoke_hook
+
+        raw_results = _invoke_hook("telegram_passive_update", event=event)
+        hook_results = raw_results if isinstance(raw_results, (list, tuple)) else []
+        handled = any(
+            isinstance(result, dict) and result.get("handled") is True
+            for result in hook_results
+        )
+        if handled:
+            self._get_passive_media_spool().acknowledge_result(event)
+            return True
+        logger.critical(
+            "[%s] Telegram passive media result retained; collector did not acknowledge it",
+            self.name,
+        )
+        return False
+
+    async def _process_passive_media_job(self, job: dict[str, Any]) -> bool:
+        """Process one job serially with the already-running PTB Bot instance."""
+        spool = self._get_passive_media_spool()
+        temp_path: Optional[_Path] = None
+        try:
+            if job.get("processor_version") != self._passive_media_processor_version():
+                logger.error(
+                    "[%s] Telegram passive media job retained after processor change",
+                    self.name,
+                )
+                return False
+            status = job.get("preflight_status")
+            transcription = None
+            if status is None:
+                bot = self._bot
+                if bot is None:
+                    raise MediaTransientError("telegram_not_connected")
+                try:
+                    telegram_file = await asyncio.wait_for(
+                        bot.get_file(
+                            job["file_id"],
+                            read_timeout=15.0,
+                            connect_timeout=5.0,
+                            pool_timeout=5.0,
+                        ),
+                        timeout=20.0,
+                    )
+                    reported_size = getattr(telegram_file, "file_size", None)
+                    if (
+                        isinstance(reported_size, int)
+                        and not isinstance(reported_size, bool)
+                        and reported_size > MAX_MEDIA_FILE_BYTES
+                    ):
+                        raise MediaPermanentError("too_large")
+                    temp_path = spool.create_private_temp(job["job_id"])
+                    await asyncio.wait_for(
+                        telegram_file.download_to_drive(
+                            custom_path=temp_path,
+                            read_timeout=60.0,
+                            write_timeout=60.0,
+                            connect_timeout=5.0,
+                            pool_timeout=5.0,
+                        ),
+                        timeout=90.0,
+                    )
+                except asyncio.CancelledError:
+                    raise
+                except MediaPermanentError:
+                    raise
+                except Exception as exc:
+                    if self._passive_media_download_is_permanent(exc):
+                        raise MediaPermanentError(
+                            "download_failed_permanent"
+                        ) from exc
+                    raise MediaTransientError("download_failed") from exc
+                try:
+                    info = temp_path.stat()
+                except OSError as exc:
+                    raise MediaTransientError("download_temp_unavailable") from exc
+                if not 0 < info.st_size <= MAX_MEDIA_FILE_BYTES:
+                    raise MediaPermanentError("too_large")
+                transcription = await self._get_passive_media_asr().transcribe(
+                    temp_path,
+                    media_kind=job["media_kind"],
+                )
+                status = "transcribed"
+
+            result = build_media_result_event(
+                job,
+                status=str(status),
+                processor=self._passive_media_processor_identity(),
+                transcript=(transcription.transcript if transcription else None),
+                language=(transcription.language if transcription else None),
+                content_sha256=(
+                    transcription.content_sha256 if transcription else None
+                ),
+                actual_bytes=(transcription.actual_bytes if transcription else None),
+                duration_ms=(transcription.duration_ms if transcription else None),
+            )
+            # Result fsync precedes job ACK.  Startup reconciliation closes the
+            # crash window between these two operations without retranscribing.
+            spool.put_result(result)
+            spool.acknowledge_job(job)
+            return True
+        except asyncio.CancelledError:
+            raise
+        except MediaPermanentError as exc:
+            result = build_media_result_event(
+                job,
+                status=exc.status,
+                processor=self._passive_media_processor_identity(),
+            )
+            spool.put_result(result)
+            spool.acknowledge_job(job)
+            return True
+        except MediaTransientError:
+            logger.warning(
+                "[%s] Telegram passive media job retained after transient failure",
+                self.name,
+            )
+            return False
+        except Exception as exc:
+            logger.error(
+                "[%s] Telegram passive media job retained after %s",
+                self.name,
+                type(exc).__name__,
+            )
+            return False
+        finally:
+            if temp_path is not None:
+                try:
+                    spool.discard_private_temp(temp_path)
+                except Exception as exc:
+                    logger.error(
+                        "[%s] Telegram passive media temp cleanup failed (%s)",
+                        self.name,
+                        type(exc).__name__,
+                    )
+
+    async def _passive_media_worker_loop(self) -> None:
+        """Single-concurrency media worker; never owns another Telegram poller."""
+        interval = self._coerce_float_extra(
+            "passive_media_retry_seconds",
+            30.0,
+            min_value=5.0,
+            max_value=300.0,
+        )
+        spool = self._get_passive_media_spool()
+        try:
+            while True:
+                try:
+                    await asyncio.to_thread(spool.cleanup_private_temps)
+                    await asyncio.to_thread(spool.reconcile_completed_jobs)
+                    results = await asyncio.to_thread(
+                        spool.pending_results, limit=25
+                    )
+                    result_blocked = False
+                    for result in results:
+                        handled = await asyncio.to_thread(
+                            self._dispatch_passive_media_result, result
+                        )
+                        if not handled:
+                            result_blocked = True
+                            break
+                    if not result_blocked:
+                        # A transient first job must not starve later media.
+                        # The loop remains strictly serial (concurrency=1),
+                        # but advances through one bounded batch per interval.
+                        jobs = await self._process_passive_media_batch(
+                            spool, limit=10
+                        )
+                        if jobs:
+                            completed = await asyncio.to_thread(
+                                spool.pending_results, limit=25
+                            )
+                            for result in completed:
+                                handled = await asyncio.to_thread(
+                                    self._dispatch_passive_media_result,
+                                    result,
+                                )
+                                if not handled:
+                                    break
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    logger.error(
+                        "[%s] Telegram passive media worker retrying after %s",
+                        self.name,
+                        type(exc).__name__,
+                    )
+                await asyncio.sleep(interval)
+        except asyncio.CancelledError:
+            raise
+
+    async def _process_passive_media_batch(
+        self, spool: DurableMediaSpool, *, limit: int
+    ) -> list[dict[str, Any]]:
+        """Advance a bounded serial batch even when one item is retryable."""
+        jobs = await asyncio.to_thread(
+            spool.pending_jobs, limit=max(1, min(int(limit), 25))
+        )
+        for job in jobs:
+            await self._process_passive_media_job(job)
+        return jobs
+
+    def _start_passive_media_worker(self) -> None:
+        if (
+            self._business_updates_mode() != "passive"
+            and not self._group_passive_enabled()
+        ):
+            return
+        if not self._passive_media_enabled():
+            return
+        task = self._passive_media_worker_task
+        if task and not task.done():
+            return
+        # Construction is the startup preflight for private spool permissions
+        # and the selected ASR provider credential.
+        self._get_passive_media_spool()
+        self._get_passive_media_asr()
+        self._passive_media_worker_task = asyncio.ensure_future(
+            self._passive_media_worker_loop()
+        )
+
+    async def _handle_business_update(
+        self,
+        update: Update,
+        context: ContextTypes.DEFAULT_TYPE,
+    ) -> None:
+        """Offer one Business update to plugins, then stop normal dispatch.
+
+        The callback intentionally receives only a capability-free JSON DTO —
+        never the PTB object, adapter, bot client, or token.  The core spool is
+        committed before the hook runs, so a collector/DB outage cannot lose
+        an update that Telegram already delivered.
+        """
+        mode = self._business_updates_mode()
+        if mode == "off":
+            return
+        if mode == "blocked":
+            raise ApplicationHandlerStop
+
+        try:
+            # Polling and webhook ingress normally consume Business updates in
+            # the guarded queue before they can reach this handler. Keep this
+            # path as defense-in-depth for direct Application.process_update()
+            # callers and tests; such injected updates have no Telegram ACK.
+            await self._ingest_passive_business_update_once(update)
+        except ApplicationHandlerStop:
+            raise
+        except Exception as exc:
+            logger.error(
+                "[%s] Telegram passive capture failed closed: "
+                "kind=%s update_id=%s failure=%s",
+                self.name,
+                self._safe_business_update_kind(update),
+                getattr(update, "update_id", None),
+                type(exc).__name__,
+            )
+
+        # Passive mode is fail-closed: even a missing/broken collector may not
+        # turn someone else's private chat into an Hermes assistant prompt.
+        raise ApplicationHandlerStop
+
+    async def _handle_passive_group_update(
+        self, update: Update, context: ContextTypes.DEFAULT_TYPE
+    ) -> None:
+        """Defense-in-depth route for directly injected ordinary group updates."""
+        if not self._group_passive_enabled():
+            return
+        try:
+            await self._ingest_passive_group_update_once(update)
+        except Exception as exc:
+            logger.error(
+                "[%s] Telegram passive group capture failed closed: update_id=%s failure=%s",
+                self.name, getattr(update, "update_id", None), type(exc).__name__,
+            )
+        raise ApplicationHandlerStop
+
+    async def _handle_passive_group_membership(
+        self, update: Update, context: ContextTypes.DEFAULT_TYPE
+    ) -> None:
+        """Ask the configured owner to opt a newly joined group into capture."""
+        if not self._group_passive_enabled():
+            return
+        membership = getattr(update, "my_chat_member", None)
+        chat = getattr(membership, "chat", None)
+        chat_type = str(getattr(chat, "type", "") or "")
+        if membership is None or chat_type not in {"group", "supergroup"}:
+            return
+        chat_id = int(getattr(chat, "id", 0) or 0)
+        if chat_id >= 0:
+            return
+        owner_id = self._group_passive_owner_id()
+        registry = self._get_passive_group_registry()
+        was_present = self._chat_member_is_present(
+            getattr(membership, "old_chat_member", None)
+        )
+        is_present = self._chat_member_is_present(
+            getattr(membership, "new_chat_member", None)
+        )
+        if was_present == is_present:
+            return
+
+        if not is_present:
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            return
+
+        actor_id = int(getattr(getattr(membership, "from_user", None), "id", 0) or 0)
+        if actor_id != owner_id:
+            # This is a personal assistant: another group member cannot enroll
+            # it on the owner's behalf.  Persist denial before the network call
+            # so even a failed leave cannot expose group content.
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            if self._bot is not None:
+                try:
+                    await self._bot.leave_chat(chat_id=chat_id)
+                except Exception as exc:
+                    logger.warning(
+                        "[%s] Could not leave owner-unauthorized Telegram group: %s",
+                        self.name, type(exc).__name__,
+                    )
+            return
+
+        title, username = self._group_consent_label(chat)
+        nonce = registry.begin(
+            chat_id=chat_id,
+            owner_id=owner_id,
+            title=title,
+            username=username,
+        )
+        suffix = f" (@{_html.escape(username)})" if username else ""
+        text = (
+            "🎧 <b>Подключить пассивного секретаря?</b>\n\n"
+            f"Группа: <b>{_html.escape(title)}</b>{suffix}\n\n"
+            "После подтверждения я буду сохранять только новые сообщения. "
+            "Голосовые и кружки расшифрую, у документов сохраню только метаданные. "
+            "В самой группе отвечать не буду."
+        )
+        keyboard = InlineKeyboardMarkup(
+            [
+                [InlineKeyboardButton(
+                    "✅ Да, подключить", callback_data=f"pg:y:{nonce}"
+                )],
+                [InlineKeyboardButton(
+                    "❌ Нет", callback_data=f"pg:n:{nonce}"
+                )],
+            ]
+        )
+        if self._bot is None:
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            return
+        try:
+            await self._bot.send_message(
+                chat_id=owner_id,
+                text=text,
+                parse_mode=ParseMode.HTML,
+                reply_markup=keyboard,
+            )
+        except Exception as exc:
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            try:
+                await self._bot.leave_chat(chat_id=chat_id)
+            except Exception:
+                pass
+            logger.warning(
+                "[%s] Passive group consent DM failed closed: %s",
+                self.name, type(exc).__name__,
+            )
+
+    async def _handle_passive_group_consent_callback(
+        self, update: Update, context: ContextTypes.DEFAULT_TYPE
+    ) -> None:
+        query = getattr(update, "callback_query", None)
+        data = getattr(query, "data", None)
+        if query is None or not isinstance(data, str):
+            return
+        parts = data.split(":", 2)
+        if len(parts) != 3 or parts[0] != "pg" or parts[1] not in {"y", "n"}:
+            await query.answer(text="Некорректное подтверждение.")
+            return
+        owner_id = self._group_passive_owner_id()
+        caller_id = int(getattr(getattr(query, "from_user", None), "id", 0) or 0)
+        message = getattr(query, "message", None)
+        callback_chat = getattr(message, "chat", None)
+        callback_chat_id = int(getattr(callback_chat, "id", 0) or 0)
+        callback_chat_type = str(getattr(callback_chat, "type", "") or "")
+        if (
+            caller_id != owner_id
+            or callback_chat_id != owner_id
+            or callback_chat_type != "private"
+        ):
+            await query.answer(text="⛔ Подтвердить может только владелец бота.")
+            return
+
+        approve = parts[1] == "y"
+        record = self._get_passive_group_registry().resolve(
+            nonce=parts[2], owner_id=owner_id, approve=approve
+        )
+        if record is None:
+            await query.answer(text="⌛ Запрос истёк или уже обработан.")
+            return
+        title = _html.escape(str(record.get("title") or "Группа Telegram"))
+        chat_id = int(record["chat_id"])
+        if approve:
+            answer = "✅ Группа подключена"
+            rendered = (
+                f"✅ <b>{title}</b> подключена к пассивному секретарю.\n\n"
+                "Сохраняются только новые сообщения после этого подтверждения. "
+                "В группе бот остаётся молчаливым."
+            )
+        else:
+            answer = "❌ Группа не подключена"
+            rendered = f"❌ <b>{title}</b> не подключена. Бот выходит из группы."
+            if self._bot is not None:
+                try:
+                    await self._bot.leave_chat(chat_id=chat_id)
+                except Exception as exc:
+                    logger.warning(
+                        "[%s] Passive group leave after denial failed: %s",
+                        self.name, type(exc).__name__,
+                    )
+        await query.answer(text=answer)
+        try:
+            await query.edit_message_text(
+                text=rendered,
+                parse_mode=ParseMode.HTML,
+                reply_markup=None,
+            )
+        except Exception:
+            pass
+
+    @staticmethod
+    def _safe_business_update_kind(update: Update) -> str:
+        try:
+            return business_update_kind(update)
+        except Exception:
+            return "unknown"
+
+    def _register_application_handlers(self, app: Application) -> None:
+        """Register PTB handlers in deterministic routing priority order."""
+        # Validate the literal bool before any polling/webhook handlers can be
+        # registered. Strings and integers must not silently widen capture.
+        self._business_reply_enabled()
+        business_mode = self._business_updates_mode()
+        group_passive = self._group_passive_enabled()
+        if group_passive:
+            self._group_passive_chat_ids()
+            self._group_passive_owner_id()
+            self._get_passive_group_registry()
+            self._get_passive_update_spool()
+            if self._passive_media_enabled():
+                self._get_passive_media_spool()
+        if business_mode in {"blocked", "passive"}:
+            if any(
+                dependency is None
+                for dependency in (
+                    ApplicationHandlerStop,
+                    BusinessConnectionHandler,
+                    BusinessMessagesDeletedHandler,
+                )
+            ):
+                raise RuntimeError(
+                    "Telegram passive mode requires python-telegram-bot >= 21.1"
+                )
+            if business_mode == "passive":
+                self._business_owner_ids()
+                # Startup preflight: passive mode must not begin consuming
+                # updates unless its fsync-backed local inbox is usable.
+                self._get_passive_update_spool()
+                if self._passive_media_enabled():
+                    # Opt-in only.  Raw passive capture remains independent
+                    # and fully available while this literal flag is false.
+                    self._get_passive_media_spool()
+                # ``blocked`` mode intentionally discards Business lifecycle
+                # updates while Telegram's offset advances.  Invalidate cached
+                # enabled state before polling so the first message for every
+                # connection must re-check current enabled/rights state through
+                # getBusinessConnection.
+                self._get_passive_connection_registry().invalidate_enabled()
+            # PTB runs smaller group numbers first.  These four update types
+            # are mutually exclusive; ApplicationHandlerStop prevents any
+            # broad MessageHandler in group 0 from seeing Business content.
+            app.add_handler(
+                BusinessConnectionHandler(self._handle_business_update, block=True),
+                group=-10,
+            )
+            app.add_handler(
+                TelegramMessageHandler(
+                    filters.UpdateType.BUSINESS_MESSAGE,
+                    self._handle_business_update,
+                    block=True,
+                ),
+                group=-10,
+            )
+            app.add_handler(
+                TelegramMessageHandler(
+                    filters.UpdateType.EDITED_BUSINESS_MESSAGE,
+                    self._handle_business_update,
+                    block=True,
+                ),
+                group=-10,
+            )
+            app.add_handler(
+                BusinessMessagesDeletedHandler(
+                    self._handle_business_update,
+                    block=True,
+                ),
+                group=-10,
+            )
+
+        if group_passive:
+            app.add_handler(
+                ChatMemberHandler(
+                    self._handle_passive_group_membership,
+                    ChatMemberHandler.MY_CHAT_MEMBER,
+                    block=True,
+                ),
+                group=-9,
+            )
+            app.add_handler(
+                CallbackQueryHandler(
+                    self._handle_passive_group_consent_callback,
+                    pattern=r"^pg:[yn]:[A-Za-z0-9_-]{20,32}$",
+                    block=True,
+                ),
+                # Keep this in the same group as the generic callback router.
+                # PTB selects only the first matching handler per group, so a
+                # consent tap cannot fall through and be interpreted twice.
+                group=0,
+            )
+            app.add_handler(
+                TelegramMessageHandler(
+                    filters.ChatType.GROUPS,
+                    self._handle_passive_group_update,
+                    block=True,
+                ),
+                group=-9,
+            )
+
+        # The passive ingress guards precede every normal command/media lane.
+        # Reuse upstream registration so inline and observer handlers survive
+        # both the first connection and a transient-initialization rebuild.
+        self._wire_plugin_handlers(app)
+        self._register_handlers(app)
+
+    async def _on_platform_update(self, update, context) -> None:
+        """Catch-all PTB handler firing ``gateway_platform_event`` per inbound update.
+
+        Normalizes the update into a stable envelope (no raw SDK objects; see
+        #64176), then forwards it with an internal source to the gateway-owned
+        post-auth boundary. Registered in a dedicated high group so it observes
+        alongside, never displaces, the core handlers. Malformed updates and
+        dispatch errors cannot raise into PTB's update loop.
+        """
+        handler: Optional[Callable[[Dict[str, Any], Any], Awaitable[None]]] = getattr(
+            self, "_platform_event_handler", None
+        )
+        if handler is None:
+            return
+        try:
+            from hermes_cli.lifecycle import has_hook
+
+            if not has_hook("gateway_platform_event"):
+                return
+            event = self._normalize_platform_event(update)
+        except Exception:
+            logger.debug("[%s] gateway_platform_event normalize error", self.name, exc_info=True)
+            return
+        if event is None:
+            return
+        # The catch-all sees every inbound update. Hand the normalized envelope
+        # and its internal source to the gateway-owned boundary, where the full
+        # profile-scoped authorization chain runs before plugin dispatch. No
+        # callback means no trusted auth boundary, so fail closed.
+        try:
+            source = self._source_for_platform_event_auth(update)
+            await handler(event, source)
+        except Exception:
+            logger.debug("[%s] gateway_platform_event dispatch error", self.name, exc_info=True)
+            return
+
+    def _source_for_platform_event_auth(self, update):
+        """Route a supported update to its event-specific auth-source extractor.
+
+        Every ``gateway_platform_event`` type needs its own identity
+        extraction (a reaction carries the reactor; an edit carries the
+        editor). Raises ``ValueError`` for updates without a wired extractor
+        so the post-auth boundary fails closed rather than authorizing an
+        incomplete source.
+        """
+        if getattr(update, "message_reaction", None) is not None:
+            return self._source_from_reaction_for_auth(update)
+        edited = getattr(update, "edited_message", None)
+        if edited is not None:
+            source = self._source_from_message_for_auth(edited)
+            # _source_from_message_for_auth tolerates missing identities for
+            # its pairing-flow callers; the platform-event boundary must not.
+            if not source.user_id or not source.chat_id:
+                raise ValueError(
+                    "gateway_platform_event message_edited requires editor "
+                    "and chat identities"
+                )
+            return source
+        raise ValueError(
+            "gateway_platform_event source extraction has no extractor for "
+            "this update type"
+        )
+
+    def _normalize_platform_event(self, update) -> Optional[Dict[str, Any]]:
+        """Map an inbound PTB update to a normalized ``gateway_platform_event``
+        envelope ``{platform, event_type, payload}``, or ``None`` if unsupported.
+
+        Each supported event type has its own event-local, additive payload
+        contract (documented in hooks.md). Raw SDK objects never leave this
+        boundary. Update types without a wired contract (forward, chat-member)
+        return ``None`` unless and until they gain a concrete contract and
+        current fire-site consumer.
+        """
+        if getattr(update, "message_reaction", None) is not None:
+            return self._normalize_reaction_event(update)
+        if getattr(update, "edited_message", None) is not None:
+            return self._normalize_message_edited_event(update)
+        return None
+
+    def _normalize_reaction_event(self, update) -> Optional[Dict[str, Any]]:
+        """Normalize a ``message_reaction`` update (event_type ``reaction``).
+
+        Reaction (the motivating use case: a plugin that re-renders or reacts to
+        a message when the user reacts to it) is normalized to the fields a
+        plugin consumes: ``emojis`` (standard unicode), ``custom_emoji_ids``
+        (custom reaction emojis — PTB exposes ``custom_emoji_id`` with no
+        ``.emoji``), ``chat_id``, ``message_id``, ``thread_id``.
+        """
+        mr = getattr(update, "message_reaction", None)
+        if mr is None:
+            return None
+        chat = getattr(mr, "chat", None)
+        new_reaction = getattr(mr, "new_reaction", None) or []
+        if not isinstance(new_reaction, (list, tuple)):
+            return None
+        chat_id = getattr(chat, "id", None) if chat is not None else None
+        message_id = getattr(mr, "message_id", None)
+        if (
+            isinstance(chat_id, bool)
+            or not isinstance(chat_id, (str, int))
+            or isinstance(message_id, bool)
+            or not isinstance(message_id, (str, int))
+        ):
+            return None
+        emojis: List[str] = []
+        custom_emoji_ids: List[str] = []
+        for r in new_reaction[:64]:
+            emoji = getattr(r, "emoji", None)
+            if isinstance(emoji, str) and emoji:
+                emojis.append(emoji[:64])
+            custom_id = getattr(r, "custom_emoji_id", None)
+            if (
+                not isinstance(custom_id, bool)
+                and isinstance(custom_id, (str, int))
+            ):
+                custom_emoji_ids.append(str(custom_id)[:128])
+        return {
+            "platform": "telegram",
+            "event_type": "reaction",
+            "payload": {
+                "emojis": emojis,
+                "custom_emoji_ids": custom_emoji_ids,
+                "chat_id": str(chat_id)[:128],
+                "message_id": str(message_id)[:128],
+                # Reactions don't carry thread_id; do not guess it or expose an
+                # adapter object as a routing escape hatch.
+                "thread_id": None,
+            },
+        }
+
+    def _normalize_message_edited_event(self, update) -> Optional[Dict[str, Any]]:
+        """Normalize an ``edited_message`` update (event_type ``message_edited``).
+
+        Payload contract (v1, additive): ``chat_id``, ``message_id``,
+        ``thread_id`` (forum topic when present), ``text`` (edited text or
+        caption, bounded), ``edited_at`` (ISO 8601 UTC or None). No raw PTB
+        ``Message`` object leaves this boundary. Malformed identities return
+        ``None`` so the fire-site drops the event.
+        """
+        message = getattr(update, "edited_message", None)
+        if message is None:
+            return None
+        chat = getattr(message, "chat", None)
+        chat_id = getattr(chat, "id", None) if chat is not None else None
+        message_id = getattr(message, "message_id", None)
+        if (
+            isinstance(chat_id, bool)
+            or not isinstance(chat_id, (str, int))
+            or isinstance(message_id, bool)
+            or not isinstance(message_id, (str, int))
+        ):
+            return None
+        text = getattr(message, "text", None) or getattr(message, "caption", None)
+        if not isinstance(text, str):
+            text = None
+        thread_id = None
+        thread_id_raw = getattr(message, "message_thread_id", None)
+        if (
+            not isinstance(thread_id_raw, bool)
+            and isinstance(thread_id_raw, (str, int))
+            and bool(getattr(message, "is_topic_message", False))
+        ):
+            thread_id = str(thread_id_raw)[:128]
+        edited_at = None
+        edit_date = getattr(message, "edit_date", None)
+        try:
+            if edit_date is not None and hasattr(edit_date, "isoformat"):
+                edited_at = str(edit_date.isoformat())[:64]
+        except Exception:
+            edited_at = None
+        return {
+            "platform": "telegram",
+            "event_type": "message_edited",
+            "payload": {
+                "chat_id": str(chat_id)[:128],
+                "message_id": str(message_id)[:128],
+                "thread_id": thread_id,
+                "text": text[:8192] if text is not None else None,
+                "edited_at": edited_at,
+            },
+        }
+
+    def _register_handlers(self, app) -> None:
+        """Register every PTB handler on ``app``.
+
+        Single source of truth for handler registration. Both initial connect
+        and the transient-initialization rebuild path call this method, keeping
+        the ``gateway_platform_event`` observer (group 99) in lockstep with the
+        core handlers.
+        """
+        app.add_handler(TelegramMessageHandler(
+            filters.TEXT & ~filters.COMMAND,
+            self._handle_text_message
+        ))
+        app.add_handler(TelegramMessageHandler(
+            filters.COMMAND,
+            self._handle_command
+        ))
+        app.add_handler(TelegramMessageHandler(
+            filters.LOCATION | getattr(filters, "VENUE", filters.LOCATION),
+            self._handle_location_message
+        ))
+        app.add_handler(TelegramMessageHandler(
+            filters.PHOTO | filters.VIDEO | filters.AUDIO | filters.VOICE | filters.Document.ALL | filters.Sticker.ALL,
+            self._handle_media_message
+        ))
+        # Handle inline keyboard button callbacks (update prompts)
+        app.add_handler(CallbackQueryHandler(self._handle_callback_query))
+        # Inline command picker (@botname <query>) — searchable, uncapped
+        # access to every command/skill. Inert until the bot owner enables
+        # inline mode via BotFather /setinline (Telegram never delivers
+        # inline_query updates otherwise), so registering unconditionally
+        # is safe.
+        app.add_handler(InlineQueryHandler(self._handle_inline_query))
+        # gateway_platform_event observer (see _on_platform_update); group 99 so
+        # it observes alongside, never displaces, the core handlers.
+        app.add_handler(TypeHandler(Update, self._on_platform_update), group=99)
+
+    async def connect(self, *, is_reconnect: bool = False) -> bool:
+        """Connect to Telegram via polling or webhook.
+
+        By default, uses long polling (outbound connection to Telegram).
+        If ``TELEGRAM_WEBHOOK_URL`` is set, starts an HTTP webhook server
+        instead.  Webhook mode is useful for cloud deployments (Fly.io,
+        Railway) where inbound HTTP can wake a suspended machine.
+
+        ``is_reconnect`` distinguishes a cold first boot (False — drop any
+        stale Bot API queue) from a watcher reconnect after a prolonged
+        outage (True — preserve the updates Telegram queued while the bot
+        was offline, otherwise every message sent during the outage is
+        silently lost). The in-process network-error ladder and the
+        409-conflict handler already pass ``drop_pending_updates=False``
+        for the same reason; bootstrap follows suit on the reconnect path.
+
+        Env vars for webhook mode::
+
+            TELEGRAM_WEBHOOK_URL    Public HTTPS URL (e.g. https://app.fly.dev/telegram)
+            TELEGRAM_WEBHOOK_PORT   Local listen port (default 8443)
+            TELEGRAM_WEBHOOK_HOST   Bind host (default: unset → dual-stack,
+                                    all interfaces IPv4+IPv6)
+            TELEGRAM_WEBHOOK_SECRET Secret token for update verification
+        """
+        # Explicit connect() is the only operation allowed to reopen polling
+        # after a completed, serialized teardown. Background recovery never
+        # clears this fence.
+        self._polling_teardown_started = False
+        # Mode selection is re-evaluated on every explicit connection. Keep
+        # webhook state false unless this connection starts its webhook.
+        self._webhook_mode = False
+
+        if not TELEGRAM_AVAILABLE:
+            logger.error(
+                "[%s] python-telegram-bot not installed. Run: pip install python-telegram-bot",
+                self.name,
+            )
+            self._set_fatal_error("missing_dependency", "python-telegram-bot not installed", retryable=False)
+            return False
+        
+        if not self.config.token:
+            logger.error("[%s] No bot token configured", self.name)
+            self._set_fatal_error("missing_credentials", "No bot token configured", retryable=False)
+            return False
+        
+        try:
+            if not self._acquire_platform_lock('telegram-bot-token', self.config.token, 'Telegram bot token'):
+                return False
+
+            # Build the application
+            builder = Application.builder().token(self.config.token)
+            if self._business_updates_mode() == "passive" or self._group_passive_enabled():
+                # PTB awaits this queue before advancing the getUpdates offset
+                # (and before returning HTTP 200 in webhook mode). Business
+                # updates therefore reach an fsync-backed local inbox first.
+                self._passive_ingress_queue = _DurableBusinessIngressQueue(
+                    is_guarded=self._is_guarded_passive_business_update,
+                    durable_put=self._route_update_through_durable_ingress,
+                )
+                builder = builder.update_queue(self._passive_ingress_queue)
+            else:
+                self._passive_ingress_queue = None
+            custom_base_url = self.config.extra.get("base_url")
+            if custom_base_url:
+                builder = builder.base_url(custom_base_url)
+                builder = builder.base_file_url(
+                    self.config.extra.get("base_file_url", custom_base_url)
+                )
+                logger.info(
+                    "[%s] Using custom Telegram base_url: %s",
+                    self.name, custom_base_url,
+                )
+            # In local-mode telegram-bot-api, file_path is an absolute path on the
+            # server's filesystem rather than a relative HTTP path. PTB needs
+            # local_mode=True so download_*() reads from disk instead of issuing
+            # an HTTP GET that would 404. Requires that the same path is
+            # readable by the Hermes process (shared mount, same machine, etc.).
+            if self.config.extra.get("local_mode"):
+                builder = builder.local_mode(True)
+                logger.info("[%s] Using Telegram local_mode (read files from disk)", self.name)
+
+            # PTB defaults (pool_timeout=1s) are too aggressive on flaky networks and
+            # can trigger "Pool timeout: All connections in the connection pool are occupied"
+            # during reconnect/bootstrap. Use safer defaults and allow env overrides.
+            def _env_int(name: str, default: int) -> int:
+                try:
+                    return int(os.getenv(name, str(default)))
+                except (TypeError, ValueError):
+                    return default
+
+            def _env_float(name: str, default: float) -> float:
+                try:
+                    return float(os.getenv(name, str(default)))
+                except (TypeError, ValueError):
+                    return default
+
+            request_kwargs = {
+                "connection_pool_size": _env_int("HERMES_TELEGRAM_HTTP_POOL_SIZE", 512),
+                "pool_timeout": _env_float("HERMES_TELEGRAM_HTTP_POOL_TIMEOUT", 8.0),
+                "connect_timeout": _env_float("HERMES_TELEGRAM_HTTP_CONNECT_TIMEOUT", 10.0),
+                "read_timeout": _env_float("HERMES_TELEGRAM_HTTP_READ_TIMEOUT", 20.0),
+                "write_timeout": _env_float("HERMES_TELEGRAM_HTTP_WRITE_TIMEOUT", 20.0),
+                # Not a duplicate of write_timeout: PTB routes any request
+                # carrying files to media_write_timeout instead, so the line
+                # above never applied to an upload and every upload was pinned
+                # to PTB's own 20s default. httpx budgets this per socket
+                # write rather than across the upload, so it is stall
+                # tolerance, not a size or bandwidth allowance — a slow but
+                # steady uplink never accumulates against it. 60s rides out
+                # the buffer stalls a congested link produces; going higher
+                # only lengthens how long a dead socket takes to report
+                # itself.
+                "media_write_timeout": 60.0,
+            }
+
+            # CLOSE_WAIT fd leak (#31599, same class as #18451): PTB's
+            # HTTPXRequest builds the underlying httpx.AsyncClient with
+            # `limits = httpx.Limits(max_connections=connection_pool_size)`
+            # and *no* keepalive tuning, so httpx's default
+            # keepalive_expiry=5.0 applies. Behind an HTTP proxy (Cloudflare
+            # Warp etc.) a peer-initiated FIN can sit in CLOSE_WAIT longer
+            # than that, leaking fds in the general request pool (_request[1])
+            # which _drain_polling_connections never resets. Wire the shared
+            # platform_httpx_limits() helper into the httpx client so idle
+            # keepalive sockets drain aggressively, while preserving PTB's
+            # max_connections (= connection_pool_size). httpx_kwargs is spread
+            # last into PTB's client kwargs, so `limits` here wins.
+            from gateway.platforms._http_client_limits import platform_httpx_limits
+
+            _base_limits = platform_httpx_limits()
+            if _base_limits is not None:
+                import httpx as _httpx
+
+                _pool_limits = _httpx.Limits(
+                    max_connections=request_kwargs["connection_pool_size"],
+                    max_keepalive_connections=_base_limits.max_keepalive_connections,
+                    keepalive_expiry=_base_limits.keepalive_expiry,
+                )
+                # A long-poll request is continuously active, so keepalive
+                # expiry cannot protect it from a server-side connection close.
+                # Never hand getUpdates a pooled socket from a previous poll;
+                # ordinary Bot API requests retain the shared reusable pool.
+                _updates_limits = _httpx.Limits(
+                    max_connections=request_kwargs["connection_pool_size"],
+                    max_keepalive_connections=0,
+                    keepalive_expiry=_base_limits.keepalive_expiry,
+                )
+            else:  # pragma: no cover — httpx always present alongside PTB
+                _pool_limits = None
+                _updates_limits = None
+
+            def _with_limits(httpx_kwargs: Optional[dict] = None) -> dict:
+                """Merge tuned keepalive limits into httpx client kwargs.
+
+                Used by the proxy and direct-DNS branches, where httpx honours
+                the client-level ``limits`` kwarg. A caller-supplied ``limits``
+                is left untouched; otherwise the CLOSE_WAIT-safe limits are
+                injected. The fallback-IP branch does NOT use this helper — see
+                the ``_transport_kwargs`` note below for why.
+                """
+                kwargs = dict(httpx_kwargs or {})
+                if _pool_limits is not None and "limits" not in kwargs:
+                    kwargs["limits"] = _pool_limits
+                return kwargs
+
+            disable_fallback = (
+                os.getenv("HERMES_TELEGRAM_DISABLE_FALLBACK_IPS", "")
+                .strip()
+                .lower()
+                in {"1", "true", "yes", "on"}
+            )
+            fallback_ips = self._fallback_ips()
+            if disable_fallback:
+                fallback_ips = []
+            if not fallback_ips and not disable_fallback:
+                discovery_timeout = self._env_float_clamped(
+                    "HERMES_TELEGRAM_FALLBACK_DISCOVERY_TIMEOUT",
+                    5.0,
+                    min_value=0.0,
+                )
+                logger.warning(
+                    "[%s] Discovering Telegram API fallback IPs via DNS-over-HTTPS…",
+                    self.name,
+                )
+                try:
+                    fallback_ips = await _await_with_thread_deadline(
+                        discover_fallback_ips(),
+                        timeout=discovery_timeout,
+                    )
+                except Exception as exc:
+                    logger.warning(
+                        "[%s] Telegram fallback-IP discovery failed after %.0fs; "
+                        "using seed IPv4 Telegram API IPs so a blackholed IPv6 "
+                        "hostname path cannot hang initialize() (#87015): %s",
+                        self.name,
+                        discovery_timeout,
+                        _redact_telegram_error_text(exc),
+                    )
+                    fallback_ips = list(SEED_FALLBACK_IPS)
+                else:
+                    logger.info(
+                        "[%s] Auto-discovered Telegram fallback IPs: %s",
+                        self.name,
+                        ", ".join(fallback_ips),
+                    )
+
+            proxy_targets = ["api.telegram.org", *fallback_ips]
+            proxy_url = resolve_proxy_url("TELEGRAM_PROXY", target_hosts=proxy_targets)
+            use_fallback_transport = bool(
+                fallback_ips and not proxy_url and not disable_fallback
+            )
+            fallback_transport_kwargs: dict[str, Any] = {}
+            if use_fallback_transport:
+                logger.info(
+                    "[%s] Telegram fallback IPs active: %s",
+                    self.name,
+                    ", ".join(fallback_ips),
+                )
+                # Keep request/update pools separate to reduce contention during
+                # polling reconnect + bot API bootstrap/delete_webhook calls.
+                # httpx ignores the client-level `limits` kwarg when a custom
+                # `transport` is supplied (#58790).  Unlike the proxy/direct
+                # branches (which inject limits at the client level via
+                # `_with_limits`), this branch MUST pass the tuned limits
+                # directly into TelegramFallbackTransport so its inner
+                # AsyncHTTPTransport instances honour keepalive_expiry — do not
+                # route this through `_with_limits`, httpx would discard it.
+                if _pool_limits is not None:
+                    fallback_transport_kwargs["limits"] = _pool_limits
+                fallback_transport_kwargs["socket_options"] = tcp_keepalive_socket_options()
+            elif proxy_url:
+                logger.info("[%s] Proxy detected; passing explicitly to HTTPXRequest: %s", self.name, proxy_url)
+            elif disable_fallback:
+                logger.info("[%s] Telegram fallback-IP transport disabled via env", self.name)
+
+            def _build_request_pair() -> tuple[Any, Any]:
+                """Create independent general/polling clients for one Bot."""
+                if use_fallback_transport:
+                    updates_transport_kwargs = dict(fallback_transport_kwargs)
+                    if _updates_limits is not None:
+                        updates_transport_kwargs["limits"] = _updates_limits
+                    request = HTTPXRequest(
+                        **request_kwargs,
+                        httpx_kwargs={
+                            "transport": TelegramFallbackTransport(
+                                fallback_ips, **fallback_transport_kwargs
+                            )
+                        },
+                    )
+                    get_updates_request = HTTPXRequest(
+                        **request_kwargs,
+                        httpx_kwargs={
+                            "transport": TelegramFallbackTransport(
+                                fallback_ips, **updates_transport_kwargs
+                            )
+                        },
+                    )
+                elif proxy_url:
+                    request = HTTPXRequest(
+                        **request_kwargs,
+                        proxy=proxy_url,
+                        httpx_kwargs=_with_limits(),
+                    )
+                    get_updates_request = HTTPXRequest(
+                        **request_kwargs,
+                        proxy=proxy_url,
+                        httpx_kwargs={"limits": _updates_limits},
+                    )
+                else:
+                    request = HTTPXRequest(
+                        **request_kwargs, httpx_kwargs=_with_limits()
+                    )
+                    get_updates_request = HTTPXRequest(
+                        **request_kwargs, httpx_kwargs={"limits": _updates_limits}
+                    )
+                return request, self._instrument_polling_request(
+                    get_updates_request
+                )
+
+            if self._business_updates_mode() == "passive" or self._group_passive_enabled():
+                passive_ingress_queue = self._passive_ingress_queue
+                if passive_ingress_queue is None:  # pragma: no cover - startup invariant
+                    raise RuntimeError("Telegram passive ingress queue is unavailable")
+                passive_bot_kwargs: dict[str, Any] = {
+                    "token": self.config.token,
+                    "local_mode": bool(self.config.extra.get("local_mode")),
+                }
+                if custom_base_url:
+                    passive_bot_kwargs["base_url"] = custom_base_url
+                    passive_bot_kwargs["base_file_url"] = self.config.extra.get(
+                        "base_file_url", custom_base_url
+                    )
+
+                def _build_passive_application() -> Application:
+                    # A failed initialize may leave the Bot half-initialized
+                    # while its request clients are subsequently shut down.
+                    # Recreate both the Application and ExtBot on every retry;
+                    # reusing ApplicationBuilder.bot(explicit_instance) would
+                    # silently recycle that damaged Bot object.
+                    return _build_passive_application_with_fresh_transport(
+                        bot_kwargs=passive_bot_kwargs,
+                        request_factory=_build_request_pair,
+                        update_queue=passive_ingress_queue,
+                    )
+
+                application_factory = _build_passive_application
+            else:
+                request, get_updates_request = _build_request_pair()
+                builder = builder.request(request).get_updates_request(
+                    get_updates_request
+                )
+
+                def _build_default_application() -> Application:
+                    return builder.build()
