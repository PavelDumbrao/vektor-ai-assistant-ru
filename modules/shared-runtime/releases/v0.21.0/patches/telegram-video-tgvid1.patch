@@ -0,0 +1,536 @@
+"""Tests for Telegram video metadata probing and thumbnail generation.
+
+Covers:
+  - VideoMeta dataclass
+  - probe_video:
+      * vertical 1080x1920 without rotate -> (1080, 1920)
+      * horizontal 1920x1080 with tags.rotate=90 -> (1080, 1920)
+      * horizontal 1920x1080 with side_data rotation=-90 -> (1080, 1920)
+      * SAR 4:3 on 1440x1080 -> 1920x1080
+      * duration 12.2 -> 13
+      * missing ffprobe -> None
+      * ffprobe timeout -> None
+      * garbage JSON -> None
+  - make_thumbnail:
+      * missing ffmpeg -> None
+      * successful generation -> thumbnail exists and is cleaned up
+      * oversized thumbnail -> re-encodes, fails if still oversized
+  - video_send_kwargs
+  - TelegramAdapter.send_video integration:
+      * with metadata: receives width, height, duration, supports_streaming, thumbnail
+      * without metadata: exact keys as before (regression guard)
+      * reset_media rewinds both video and thumbnail files on retry
+      * thumbnail file closed and unlinked in finally block
+      * probe/thumbnail exceptions never fail the send operation
+"""
+import asyncio
+import json
+import os
+import subprocess
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+
+from gateway.config import PlatformConfig
+from plugins.platforms.telegram import adapter as telegram_mod
+from plugins.platforms.telegram.adapter import TelegramAdapter
+from plugins.platforms.telegram.video_meta import (
+    VideoMeta,
+    make_thumbnail,
+    probe_video,
+    video_send_kwargs,
+)
+
+
+class FakeBadRequest(Exception):
+    pass
+
+
+def _make_adapter() -> TelegramAdapter:
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="***"))
+    adapter._bot = MagicMock()
+    adapter._bot.send_video = AsyncMock(return_value=SimpleNamespace(message_id=42))
+    return adapter
+
+
+def _make_dummy_video(tmp_path: Path, filename: str = "test.mp4") -> Path:
+    p = tmp_path / filename
+    p.write_bytes(b"\x00\x00\x00\x1c" + b"ftyp" + b"\x00" * 100)
+    return p
+
+
+# ===========================================================================
+# 1. probe_video tests
+# ===========================================================================
+
+def test_probe_vertical_no_rotate(monkeypatch):
+    """Vertical 1080x1920 video with no rotation -> (1080, 1920)."""
+    fake_payload = {
+        "streams": [
+            {
+                "codec_type": "video",
+                "width": 1080,
+                "height": 1920,
+                "sample_aspect_ratio": "1:1",
+                "tags": {},
+            }
+        ],
+        "format": {"duration": "10.0"},
+    }
+
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout=json.dumps(fake_payload), stderr=""
+        ),
+    )
+
+    meta = probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe")
+    assert meta is not None
+    assert meta.width == 1080
+    assert meta.height == 1920
+    assert meta.duration == 10
+    assert meta.rotation == 0
+
+
+def test_probe_horizontal_rotate_90(monkeypatch):
+    """Horizontal 1920x1080 with tags.rotate=90 -> swapped display dims (1080, 1920)."""
+    fake_payload = {
+        "streams": [
+            {
+                "codec_type": "video",
+                "width": 1920,
+                "height": 1080,
+                "sample_aspect_ratio": "1:1",
+                "tags": {"rotate": "90"},
+            }
+        ],
+        "format": {"duration": "10.0"},
+    }
+
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout=json.dumps(fake_payload), stderr=""
+        ),
+    )
+
+    meta = probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe")
+    assert meta is not None
+    assert meta.width == 1080
+    assert meta.height == 1920
+    assert meta.rotation == 90
+
+
+def test_probe_side_data_rotation_minus_90(monkeypatch):
+    """Side data rotation=-90 on 1920x1080 -> swapped display dims (1080, 1920)."""
+    fake_payload = {
+        "streams": [
+            {
+                "codec_type": "video",
+                "width": 1920,
+                "height": 1080,
+                "sample_aspect_ratio": "1:1",
+                "side_data_list": [{"rotation": -90}],
+            }
+        ],
+        "format": {"duration": "10.0"},
+    }
+
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout=json.dumps(fake_payload), stderr=""
+        ),
+    )
+
+    meta = probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe")
+    assert meta is not None
+    assert meta.width == 1080
+    assert meta.height == 1920
+    assert meta.rotation == -90
+
+
+def test_probe_sar_4_3(monkeypatch):
+    """SAR 4:3 on 1440x1080 -> 1920x1080."""
+    fake_payload = {
+        "streams": [
+            {
+                "codec_type": "video",
+                "width": 1440,
+                "height": 1080,
+                "sample_aspect_ratio": "4:3",
+            }
+        ],
+        "format": {"duration": "10.0"},
+    }
+
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout=json.dumps(fake_payload), stderr=""
+        ),
+    )
+
+    meta = probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe")
+    assert meta is not None
+    assert meta.width == 1920
+    assert meta.height == 1080
+
+
+def test_probe_duration_rounding(monkeypatch):
+    """Duration 12.2 -> ceil 13."""
+    fake_payload = {
+        "streams": [
+            {
+                "codec_type": "video",
+                "width": 1080,
+                "height": 1920,
+            }
+        ],
+        "format": {"duration": "12.2"},
+    }
+
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout=json.dumps(fake_payload), stderr=""
+        ),
+    )
+
+    meta = probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe")
+    assert meta is not None
+    assert meta.duration == 13
+
+
+def test_probe_no_ffprobe(monkeypatch):
+    """Missing ffprobe binary -> None without exceptions."""
+    monkeypatch.setattr("shutil.which", lambda _b: None)
+    assert probe_video("/fake/clip.mp4", ffprobe=None) is None
+
+
+def test_probe_timeout(monkeypatch):
+    """TimeoutExpired during ffprobe execution -> None."""
+    def _timeout(*args, **kwargs):
+        raise subprocess.TimeoutExpired(cmd=["ffprobe"], timeout=10.0)
+
+    monkeypatch.setattr(subprocess, "run", _timeout)
+    assert probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe") is None
+
+
+def test_probe_garbage_json(monkeypatch):
+    """Invalid JSON from ffprobe -> None."""
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout="not valid json {", stderr=""
+        ),
+    )
+    assert probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe") is None
+
+
+def test_probe_empty_streams(monkeypatch):
+    """No streams in ffprobe -> None."""
+    monkeypatch.setattr(
+        subprocess,
+        "run",
+        lambda *args, **kwargs: MagicMock(
+            returncode=0, stdout=json.dumps({"streams": [], "format": {"duration": "5"}}), stderr=""
+        ),
+    )
+    assert probe_video("/fake/clip.mp4", ffprobe="/usr/bin/ffprobe") is None
+
+
+# ===========================================================================
+# 2. make_thumbnail tests
+# ===========================================================================
+
+def test_thumbnail_missing_ffmpeg(monkeypatch):
+    """Missing ffmpeg -> None without exceptions."""
+    monkeypatch.setattr("shutil.which", lambda _b: None)
+    meta = VideoMeta(width=1080, height=1920, duration=10, rotation=0)
+    assert make_thumbnail("/fake/clip.mp4", meta, ffmpeg=None) is None
+
+
+def test_thumbnail_success_creates_file(monkeypatch):
+    """Successful thumbnail generation creates temporary file."""
+    def _fake_run(cmd, *args, **kwargs):
+        out_path = cmd[-1]
+        Path(out_path).write_bytes(b"\xff\xd8\xff" + b"\x00" * 1000)
+        return MagicMock(returncode=0)
+
+    monkeypatch.setattr(subprocess, "run", _fake_run)
+    meta = VideoMeta(width=1080, height=1920, duration=10, rotation=0)
+    thumb_path = make_thumbnail("/fake/clip.mp4", meta, ffmpeg="/usr/bin/ffmpeg")
+    assert thumb_path is not None
+    assert os.path.exists(thumb_path)
+    os.unlink(thumb_path)
+
+
+def test_thumbnail_oversized_reencode_and_cleanup(monkeypatch):
+    """Thumbnail exceeding 200 KB even after -q:v 10 returns None and deletes file."""
+    calls = []
+
+    def _fake_run(cmd, *args, **kwargs):
+        calls.append(cmd)
+        out_path = cmd[-1]
+        # Write 250 KB
+        Path(out_path).write_bytes(b"\x00" * (250 * 1024))
+        return MagicMock(returncode=0)
+
+    monkeypatch.setattr(subprocess, "run", _fake_run)
+    meta = VideoMeta(width=1080, height=1920, duration=10, rotation=0)
+    thumb_path = make_thumbnail("/fake/clip.mp4", meta, ffmpeg="/usr/bin/ffmpeg")
+    assert thumb_path is None
+    assert len(calls) == 2  # initial + re-encode
+    assert "-q:v" in calls[1]
+    assert calls[1][calls[1].index("-q:v") + 1] == "10"
+
