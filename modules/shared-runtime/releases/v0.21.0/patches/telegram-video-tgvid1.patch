+"""Telegram video metadata probing and thumbnail generation.
+
+Pure functions (no asyncio). Used by TelegramAdapter.send_video via
+asyncio.to_thread.
+"""
+from __future__ import annotations
+
+import json
+import logging
+import math
+import os
+import shutil
+import subprocess
+import tempfile
+from dataclasses import dataclass
+from typing import Optional
+
+logger = logging.getLogger(__name__)
+
+# Telegram thumbnail size cap is 200 KB
+MAX_THUMBNAIL_BYTES = 200 * 1024
+
+
+@dataclass
+class VideoMeta:
+    width: int
+    height: int
+    duration: int
+    rotation: int
+
+
+def _safe_unlink(path: Optional[str]) -> None:
+    if path:
+        try:
+            if os.path.exists(path):
+                os.unlink(path)
+        except OSError:
+            pass
+
+
+def probe_video(
+    path: str,
+    *,
+    ffprobe: Optional[str] = None,
+    timeout: float = 10.0,
+) -> Optional[VideoMeta]:
+    """Probe video dimensions, SAR, rotation and duration using ffprobe.
+
+    Returns VideoMeta with display dimensions (SAR-adjusted and rotation-swapped)
+    and ceiling whole-second duration (minimum 1s), or None on any failure.
+    """
+    if not path:
+        return None
+
+    ffprobe_bin = ffprobe or shutil.which("ffprobe")
+    if not ffprobe_bin:
+        logger.debug("ffprobe binary not found")
+        return None
+
+    cmd = [
+        ffprobe_bin,
+        "-v",
+        "error",
+        "-select_streams",
+        "v:0",
+        "-show_entries",
+        "stream=width,height,sample_aspect_ratio,codec_type:stream_tags=rotate:stream_side_data=rotation:format=duration",
+        "-of",
+        "json",
+        str(path),
+    ]
+
+    try:
+        proc = subprocess.run(
+            cmd,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        logger.debug("ffprobe timed out after %s s: %s", timeout, path)
+        return None
+    except Exception as exc:
+        logger.debug("ffprobe execution failed for %s: %s", path, exc)
+        return None
+
+    if proc.returncode != 0:
+        logger.debug("ffprobe returned non-zero code %s: %s", proc.returncode, proc.stderr)
+        return None
+
+    try:
+        data = json.loads(proc.stdout)
+    except Exception as exc:
+        logger.debug("Failed to parse ffprobe json output: %s", exc)
+        return None
+
+    streams = data.get("streams", [])
+    if not streams or not isinstance(streams, list):
+        logger.debug("No streams in ffprobe output for %s", path)
+        return None
+
+    stream = None
+    for s in streams:
+        if isinstance(s, dict) and s.get("codec_type") == "video":
+            stream = s
+            break
+    if stream is None:
+        if streams and isinstance(streams[0], dict):
+            stream = streams[0]
+        else:
+            logger.debug("No valid video stream in ffprobe output for %s", path)
+            return None
+
+    try:
+        raw_width = int(stream["width"])
+        raw_height = int(stream["height"])
+    except (KeyError, ValueError, TypeError) as exc:
+        logger.debug("Missing or invalid width/height in video stream: %s", exc)
+        return None
+
+    if raw_width <= 0 or raw_height <= 0:
+        logger.debug("Non-positive dimensions in video stream: %sx%s", raw_width, raw_height)
+        return None
+
+    # SAR adjustment: sample_aspect_ratio "a:b"
+    width = raw_width
+    height = raw_height
+    sar = stream.get("sample_aspect_ratio")
+    if isinstance(sar, str) and ":" in sar:
+        parts = sar.split(":", 1)
+        try:
+            num, den = float(parts[0]), float(parts[1])
+            if num > 0 and den > 0 and (num != den):
+                width = int(round((width * (num / den)) / 2.0)) * 2
+        except (ValueError, ZeroDivisionError) as exc:
+            logger.debug("Ignoring unparseable SAR %r: %s", sar, exc)
+
+    # Rotation adjustment: stream_tags=rotate or stream_side_data=rotation
+    rotation = 0
+    tags = stream.get("tags")
+    if isinstance(tags, dict) and "rotate" in tags:
+        try:
+            rotation = int(float(tags["rotate"]))
+        except (ValueError, TypeError):
+            pass
+
+    if rotation == 0:
+        side_data = stream.get("side_data_list") or stream.get("side_data") or []
+        if isinstance(side_data, list):
+            for sd in side_data:
+                if isinstance(sd, dict) and "rotation" in sd:
+                    try:
+                        rotation = int(float(sd["rotation"]))
+                        if rotation != 0:
+                            break
+                    except (ValueError, TypeError):
+                        pass
+
+    # For 90, 270, -90, -270 deg rotations, display width and height swap
+    if abs(rotation) % 180 == 90:
+        width, height = height, width
+
+    # Duration: ceil(format.duration), minimum 1
+    raw_duration = None
+    format_info = data.get("format")
+    if isinstance(format_info, dict):
+        raw_duration = format_info.get("duration")
+    if raw_duration is None or raw_duration == "N/A":
+        raw_duration = stream.get("duration")
+
+    if raw_duration is None:
+        logger.debug("No duration found in ffprobe output for %s", path)
+        return None
+
+    try:
+        dur_float = float(raw_duration)
+        duration = max(1, math.ceil(dur_float))
+    except (ValueError, TypeError) as exc:
+        logger.debug("Invalid duration value %r: %s", raw_duration, exc)
+        return None
+
+    return VideoMeta(
+        width=width,
+        height=height,
+        duration=duration,
+        rotation=rotation,
+    )
+
+
+def make_thumbnail(
+    path: str,
+    meta: VideoMeta,
+    *,
+    ffmpeg: Optional[str] = None,
+    timeout: float = 15.0,
+) -> Optional[str]:
+    """Extract a JPEG thumbnail preserving aspect ratio (longest side <= 320 px).
+
+    If the generated JPEG exceeds 200 KB, re-encodes at -q:v 10. If it still
+    exceeds 200 KB or any error occurs, returns None and cleans up the temporary file.
+    """
+    if not path:
+        return None
+
+    ffmpeg_bin = ffmpeg or shutil.which("ffmpeg")
+    if not ffmpeg_bin:
+        logger.debug("ffmpeg binary not found")
+        return None
+
+    if meta.duration <= 2:
+        t = min(1.0, max(0.0, meta.duration / 2.0))
+    else:
+        t = 1.0
+
+    t_str = f"{t:.3f}".rstrip("0").rstrip(".") if "." in f"{t:.3f}" else str(t)
+    vf_scale = "scale=w='min(320,iw)':h='min(320,ih)':force_original_aspect_ratio=decrease"
+
+    try:
+        tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".jpg")
+        tmp_path = tmp.name
+        tmp.close()
+    except Exception as exc:
+        logger.debug("Failed to create temporary file for thumbnail: %s", exc)
+        return None
+
+    cmd = [
+        ffmpeg_bin,
+        "-v",
+        "error",
+        "-y",
+        "-ss",
+        t_str,
+        "-i",
+        str(path),
+        "-frames:v",
+        "1",
+        "-vf",
+        vf_scale,
+        "-q:v",
+        "5",
+        tmp_path,
+    ]
+
+    try:
+        proc = subprocess.run(
+            cmd,
+            capture_output=True,
+            timeout=timeout,
+        )
+    except subprocess.TimeoutExpired:
+        logger.debug("ffmpeg thumbnail generation timed out after %s s: %s", timeout, path)
+        _safe_unlink(tmp_path)
+        return None
+    except Exception as exc:
+        logger.debug("ffmpeg thumbnail generation failed: %s", exc)
+        _safe_unlink(tmp_path)
+        return None
+
+    if proc.returncode != 0 or not os.path.exists(tmp_path):
+        logger.debug("ffmpeg thumbnail failed (code %s): %s", proc.returncode, proc.stderr)
+        _safe_unlink(tmp_path)
+        return None
+
+    try:
+        size = os.path.getsize(tmp_path)
+        if size == 0:
+            logger.debug("Generated thumbnail is empty")
+            _safe_unlink(tmp_path)
+            return None
+
+        if size > MAX_THUMBNAIL_BYTES:
+            # Re-encode at -q:v 10
+            cmd_reencode = [
+                ffmpeg_bin,
+                "-v",
+                "error",
+                "-y",
+                "-ss",
+                t_str,
+                "-i",
+                str(path),
+                "-frames:v",
+                "1",
+                "-vf",
+                vf_scale,
+                "-q:v",
+                "10",
+                tmp_path,
+            ]
+            proc2 = subprocess.run(
+                cmd_reencode,
+                capture_output=True,
+                timeout=timeout,
+            )
+            if proc2.returncode != 0 or not os.path.exists(tmp_path):
+                logger.debug("ffmpeg re-encode failed (code %s): %s", proc2.returncode, proc2.stderr)
+                _safe_unlink(tmp_path)
+                return None
+
+            if os.path.getsize(tmp_path) > MAX_THUMBNAIL_BYTES:
+                logger.debug("Thumbnail still exceeds %s bytes after -q:v 10", MAX_THUMBNAIL_BYTES)
+                _safe_unlink(tmp_path)
+                return None
+
+        return tmp_path
+    except Exception as exc:
+        logger.debug("Thumbnail size check/re-encode error: %s", exc)
+        _safe_unlink(tmp_path)
+        return None
+
+
+def video_send_kwargs(
+    path: str,
+    *,
+    ffprobe: Optional[str] = None,
+    ffmpeg: Optional[str] = None,
+) -> tuple[dict, Optional[str]]:
+    """Probe video metadata and generate thumbnail for Telegram send_video.
+
+    Returns (kwargs_dict, thumb_path) where kwargs_dict contains:
+    {"width": int, "height": int, "duration": int, "supports_streaming": True}.
+    If probe fails, returns ({}, None).
+    """
+    try:
+        meta = probe_video(path, ffprobe=ffprobe)
+        if meta is None:
+            return {}, None
+        thumb_path = make_thumbnail(path, meta, ffmpeg=ffmpeg)
+        kwargs = {
+            "width": meta.width,
+            "height": meta.height,
+            "duration": meta.duration,
+            "supports_streaming": True,
+        }
+        return kwargs, thumb_path
+    except Exception as exc:
+        logger.debug("video_send_kwargs failed for %s: %s", path, exc)
+        return {}, None
