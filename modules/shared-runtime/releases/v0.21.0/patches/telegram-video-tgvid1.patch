+def test_adapter_send_video_retry_resets_media_and_thumbnail(tmp_path, monkeypatch):
+    """Retry logic in _send_with_dm_topic_reply_anchor_retry seeks both video and thumbnail to 0."""
+    adapter = _make_adapter()
+    video_file = _make_dummy_video(tmp_path)
+    thumb_file = tmp_path / "thumb_retry.jpg"
+    thumb_file.write_bytes(b"\xff\xd8" + b"\x00" * 300)
+
+    extra_kwargs = {
+        "width": 1080,
+        "height": 1920,
+        "duration": 5,
+        "supports_streaming": True,
+    }
+
+    monkeypatch.setattr(
+        telegram_mod,
+        "video_send_kwargs",
+        lambda _p: (extra_kwargs, str(thumb_file)),
+    )
+
+    seek_calls = []
+
+    async def _mock_send_video(**kwargs):
+        video = kwargs["video"]
+        thumb = kwargs.get("thumbnail")
+
+        if len(seek_calls) == 0:
+            seek_calls.append("attempt_1")
+            # Read from streams during first attempt
+            video.read(10)
+            if thumb:
+                thumb.read(10)
+            raise FakeBadRequest("message thread not found")
+
+        # Second attempt checks positions before reading
+        assert video.tell() == 0, "Video file was not rewound to 0"
+        assert thumb.tell() == 0, "Thumbnail file was not rewound to 0"
+        seek_calls.append("attempt_2")
+        return SimpleNamespace(message_id=99)
+
+    adapter._bot.send_video = _mock_send_video
+
+    metadata = {
+        "thread_id": "555",
+        "telegram_dm_topic_reply_fallback": True,
+        "direct_messages_topic_id": "555",
+    }
+    result = asyncio.run(
+        adapter.send_video("12345", str(video_file), caption="Retry test", metadata=metadata)
+    )
+
+    assert result.success is True
+    assert result.message_id == "99"
+    assert seek_calls == ["attempt_1", "attempt_2"]
+    assert not os.path.exists(str(thumb_file))
+
