+# 5. End-to-end test with real /usr/bin/ffprobe and /usr/bin/ffmpeg
+# ===========================================================================
+
+def test_probe_and_thumbnail_real_binaries(tmp_path):
+    """End-to-end verification using actual /usr/bin/ffprobe and /usr/bin/ffmpeg."""
+    ffprobe_bin = "/usr/bin/ffprobe"
+    ffmpeg_bin = "/usr/bin/ffmpeg"
+    if not os.path.exists(ffprobe_bin) or not os.path.exists(ffmpeg_bin):
+        pytest.skip("ffprobe/ffmpeg not present")
+
+    # Generate a real 1080x1920 1.5s vertical video
+    real_video = tmp_path / "real_vertical.mp4"
+    gen_cmd = [
+        ffmpeg_bin,
+        "-v", "error",
+        "-y",
+        "-f", "lavfi",
+        "-i", "color=c=navy:s=1080x1920:d=1.5",
+        "-pix_fmt", "yuv420p",
+        str(real_video),
+    ]
+    subprocess.run(gen_cmd, check=True)
+
+    meta = probe_video(str(real_video), ffprobe=ffprobe_bin)
+    assert meta is not None
+    assert meta.width == 1080
+    assert meta.height == 1920
+    assert meta.duration == 2  # ceil(1.5) = 2
+
+    thumb_path = make_thumbnail(str(real_video), meta, ffmpeg=ffmpeg_bin)
+    assert thumb_path is not None
+    assert os.path.exists(thumb_path)
+    assert os.path.getsize(thumb_path) <= 200 * 1024
+
+    # Verify thumbnail dimensions with ffprobe: longest side (height) must be 320 px
+    probe_thumb_cmd = [
+        ffprobe_bin,
+        "-v", "error",
+        "-select_streams", "v:0",
+        "-show_entries", "stream=width,height",
+        "-of", "json",
+        thumb_path,
+    ]
+    res = subprocess.run(probe_thumb_cmd, capture_output=True, text=True, check=True)
+    thumb_info = json.loads(res.stdout)["streams"][0]
+    assert thumb_info["height"] == 320
+    assert thumb_info["width"] == 180  # 1080 * 320 / 1920 = 180
+
+    os.unlink(thumb_path)
