+def test_thumbnail_oversized_reencode_success(monkeypatch):
+    """Thumbnail exceeding 200 KB on first attempt, but succeeding on -q:v 10."""
+    call_count = 0
+
+    def _fake_run(cmd, *args, **kwargs):
+        nonlocal call_count
+        call_count += 1
+        out_path = cmd[-1]
+        if call_count == 1:
+            Path(out_path).write_bytes(b"\x00" * (250 * 1024))
+        else:
+            Path(out_path).write_bytes(b"\x00" * (50 * 1024))
+        return MagicMock(returncode=0)
+
+    monkeypatch.setattr(subprocess, "run", _fake_run)
+    meta = VideoMeta(width=1080, height=1920, duration=10, rotation=0)
+    thumb_path = make_thumbnail("/fake/clip.mp4", meta, ffmpeg="/usr/bin/ffmpeg")
+    assert thumb_path is not None
+    assert os.path.exists(thumb_path)
+    assert call_count == 2
+    os.unlink(thumb_path)
+
