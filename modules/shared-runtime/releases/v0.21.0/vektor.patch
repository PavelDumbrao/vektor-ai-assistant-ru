+        touch_activity_if_due = None
+
+    now = time.monotonic()
+    deadline = now + max(timeout, 0)
+    activity_state = {"last_touch": now, "start": now}
+    resolved = False
+    while True:
+        if is_interrupted():
+            entry.result = "deny"
+            entry.event.set()
+            resolved = True
