+        or isinstance(owner_id, bool)
+        or not isinstance(owner_id, int)
+        or owner_id <= 0
+        or isinstance(owner_chat_id, bool)
+        or not isinstance(owner_chat_id, int)
+        or owner_chat_id != owner_id
+        or type(adapter) is not TelegramAdapter
+        or not isinstance(loop, asyncio.AbstractEventLoop)
+        or loop.is_closed()
+    ):
+        return None
+    try:
+        if (
+            adapter._business_updates_mode() != "passive"
+            or not adapter._business_reply_enabled()
+            or owner_id not in adapter._business_owner_ids()
+        ):
+            return None
+    except Exception:
+        return None
+
+    token = object()
+    binding = _BusinessReplyBinding(
+        token=token,
+        owner_id=owner_id,
+        adapter=adapter,
+        loop=loop,
+    )
+    with _BUSINESS_REPLY_BINDINGS_LOCK:
+        _BUSINESS_REPLY_BINDINGS[session_key] = binding
+    return token
+
+
+def unbind_business_reply_capability(session_key: str, token: object) -> None:
+    """Remove only the exact live binding created for this agent run."""
+    with _BUSINESS_REPLY_BINDINGS_LOCK:
+        binding = _BUSINESS_REPLY_BINDINGS.get(session_key)
+        if binding is not None and binding.token is token:
+            _BUSINESS_REPLY_BINDINGS.pop(session_key, None)
+
