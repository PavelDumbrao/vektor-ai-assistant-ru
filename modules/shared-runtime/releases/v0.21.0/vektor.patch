+def connection(rights, owner=123, enabled=True):
+    return SimpleNamespace(id='upgrade-synthetic', user=SimpleNamespace(id=owner, is_bot=False, first_name='Test'),
+                           user_chat_id=owner, date=datetime.now(timezone.utc), is_enabled=enabled,
+                           rights=SimpleNamespace(to_dict=lambda: dict(rights)))
+
+
+def adapter():
+    return TelegramAdapter(PlatformConfig(enabled=True, token='123456:synthetic-upgrade-test', extra={
+        'business_updates_mode': 'passive', 'business_owner_ids': [123], 'business_reply_enabled': False}))
+
+
+@pytest.mark.parametrize('rights', [{}, {'can_view_gifts_and_stars': True}, {'can_read_messages': True},
+                                   {'can_reply': True}, {'can_manage_stories': True, 'can_future_action': True}])
+def test_pavel_capture_ignores_action_rights_but_keeps_valid_metadata(rights):
+    value = connection(rights)
+    assert adapter()._business_connection_capture_authorized(value)
+    assert _business_connection_payload(value, business_reply_enabled=False)['capture_authorized']
+
+
+def test_malformed_metadata_is_still_rejected():
+    assert not adapter()._business_connection_capture_authorized(connection({'can_reply': 'true'}))
+
