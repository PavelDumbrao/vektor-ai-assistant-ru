+    def _business_updates_mode(self) -> str:
+        """Return the configured Telegram Business routing posture.
+
+        ``off`` preserves upstream Hermes behaviour. ``blocked`` discards all
+        Business updates before normal dispatch. ``passive`` durably captures
+        allowlisted updates and then stops dispatch, including when a collector
+        plugin fails. That fail-closed boundary prevents private Business chat
+        content from becoming an assistant prompt.
+        """
+        raw = str((self.config.extra or {}).get("business_updates_mode") or "off")
+        mode = raw.strip().lower()
+        if mode not in {"off", "blocked", "passive"}:
+            raise ValueError(
+                f"Unknown Telegram business_updates_mode={raw!r}; "
+                "expected 'off', 'blocked', or 'passive'"
+            )
+        return mode
+
+    def _business_reply_enabled(self) -> bool:
+        """Return the literal opt-in for capture with reply-only rights.
+
+        This flag widens only the passive capture authorization profile. It
+        does not expose a Bot API client or add any outbound capability.
+        """
+        raw = (self.config.extra or {}).get("business_reply_enabled", False)
+        if type(raw) is not bool:
+            raise ValueError(
