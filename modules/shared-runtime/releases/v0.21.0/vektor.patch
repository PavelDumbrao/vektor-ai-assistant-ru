+    def _business_owner_ids(self) -> set[int]:
+        raw = (self.config.extra or {}).get("business_owner_ids")
+        parsed = _coerce_allow_set(raw)
+        result: set[int] = set()
+        for item in parsed:
+            try:
+                owner_id = int(item)
+            except (TypeError, ValueError, OverflowError) as exc:
+                raise ValueError(
+                    "Telegram business_owner_ids must contain positive integers"
+                ) from exc
+            if owner_id <= 0:
+                raise ValueError(
+                    "Telegram business_owner_ids must contain positive integers"
+                )
+            result.add(owner_id)
+        if not result:
+            raise ValueError(
+                "Telegram passive mode requires non-empty business_owner_ids"
+            )
+        return result
+
+    def _get_passive_connection_registry(self) -> BusinessConnectionRegistry:
+        if self._passive_connection_registry is None:
+            from hermes_constants import get_hermes_home
+
+            bot_id = str(self.config.token or "").partition(":")[0]
+            if not bot_id.isdigit():
+                raise ValueError("Telegram passive mode requires a valid bot token id")
+            self._passive_connection_registry = BusinessConnectionRegistry(
+                _Path("passive-secretary")
+                / "connections"
+                / f"telegram-bot-{bot_id}.json",
+                hermes_home=get_hermes_home(),
