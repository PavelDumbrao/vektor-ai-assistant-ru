+    def _get_passive_media_asr(self) -> LocalWhisperASR | OpenRouterWhisperASR:
+        if self._passive_media_asr is None:
+            provider = self._passive_media_asr_provider()
+            timeout = self._coerce_float_extra(
+                "passive_media_asr_timeout_seconds",
+                90.0 if provider == "openrouter" else 600.0,
+                min_value=30.0,
+                max_value=180.0 if provider == "openrouter" else 600.0,
+            )
+            if provider == "openrouter":
+                self._passive_media_asr = OpenRouterWhisperASR(
+                    api_key=os.environ.get("OPENROUTER_API_KEY", ""),
+                    timeout_seconds=timeout,
