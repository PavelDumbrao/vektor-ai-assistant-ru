+        )
+    if binding.loop.is_closed() or not binding.loop.is_running():
+        return BusinessReplyResult(
+            status="failed_known", error_code="gateway_loop_unavailable"
+        )
+    try:
+        if asyncio.get_running_loop() is binding.loop:
+            return BusinessReplyResult(
