+def append_volatile_user_context(content: Any, volatile_context: str) -> Any:
+    """Append one-turn plugin context without creating a persistence sidecar.
+
+    A hook result with ``persist: false`` is allowed on the wire for the
+    current provider request only.  It must never be copied into
+    ``api_content`` because that field is stored in SessionDB and replayed on
+    later turns.
+    """
+    if not volatile_context or not isinstance(content, str):
+        return content
+    return content + "\n\n" + volatile_context
 
 
