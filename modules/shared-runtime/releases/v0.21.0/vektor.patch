+def _await_gateway_one_time_decision(
+    session_key: str,
+    approval_key: str,
+    notify_cb,
+    approval_data: dict,
+) -> dict:
+    """Wait for one exact keyed decision outside the ordinary approval FIFO.
+
+    The separate map is the security boundary that prevents ``/approve``,
+    ``/approve all``, session approvals, and permanent approvals from
+    authorizing this request.  A duplicate live key is rejected rather than
+    sharing an event, so every successful wait corresponds to exactly one
+    owner-visible prompt and one grant.
+    """
+    entry = _ApprovalEntry(approval_data)
+    with _lock:
+        keyed = _gateway_one_time_queues.setdefault(session_key, {})
+        if approval_key in keyed:
+            return {
+                "resolved": False,
+                "choice": None,
+                "duplicate_pending": True,
+            }
+        keyed[approval_key] = entry
+
+    def _drop_entry() -> None:
+        with _lock:
+            queue = _gateway_one_time_queues.get(session_key)
+            if queue is None:
+                return
+            if queue.get(approval_key) is entry:
+                queue.pop(approval_key, None)
+            if not queue:
+                _gateway_one_time_queues.pop(session_key, None)
+
+    description = approval_data.get("description", "")
+    tool_name = approval_data.get("tool_name", "tool")
+    pattern_key = f"plugin_one_time:{tool_name}"
+    # Approval observers are not the consent UI. Keep exact recipient/message
+    # text out of generic plugin hooks while the notify callback below receives
+    # the full bounded display target for the owner.
+    observer_command = f"<{tool_name}> mandatory one-time action"
+    _fire_approval_hook(
+        "pre_approval_request",
+        command=observer_command,
+        description=description,
+        pattern_key=pattern_key,
+        pattern_keys=[pattern_key],
+        session_key=session_key,
+        surface="gateway_one_time",
+    )
+
+    try:
+        notify_cb(approval_data)
+    except Exception as exc:
+        logger.warning(
+            "One-time gateway approval notify failed (%s)",
+            type(exc).__name__,
+        )
+        _drop_entry()
+        return {"resolved": False, "choice": None, "notify_failed": True}
+
+    timeout = _get_approval_timeout()
+    try:
+        from tools.environments.base import touch_activity_if_due
