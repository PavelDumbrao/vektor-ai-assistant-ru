+def test_volatile_context_and_raw_provenance_survive_new_turn_builder():
+    from agent.turn_context import append_volatile_user_context
+    path = Path(__file__).parent / 'agent/test_turn_context.py'
+    spec = importlib.util.spec_from_file_location('vektor_upgrade_turn_fixture', path)
+    fixtures = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(fixtures)
+    fake = fixtures._FakeAgent()
+    fake._chat_type = 'dm'
+    fake._user_id = '123'
+    with patch('hermes_cli.lifecycle.invoke_hook', return_value=[{'context': 'PRIVATE_ONE_TURN', 'persist': False}]) as hook, \
+         patch('agent.auxiliary_client.set_runtime_main'):
+        context = fixtures._build(fake, raw_user_message='ОТПРАВИТЬ: exact input', is_internal_event=False)
+    assert context.volatile_plugin_user_context == 'PRIVATE_ONE_TURN'
+    assert 'PRIVATE_ONE_TURN' not in json.dumps(context.messages, ensure_ascii=False)
+    assert hook.call_args.kwargs['raw_user_message'] == 'ОТПРАВИТЬ: exact input'
+    assert hook.call_args.kwargs['is_internal_event'] is False
+    assert hook.call_args.kwargs['chat_type'] == 'dm'
+    assert append_volatile_user_context('visible input', context.volatile_plugin_user_context).endswith('PRIVATE_ONE_TURN')
