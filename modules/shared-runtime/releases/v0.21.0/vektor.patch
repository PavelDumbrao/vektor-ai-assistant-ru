+class _DurableBusinessIngressQueue(asyncio.Queue):
+    """PTB queue barrier that fsyncs passive Business updates before ACK.
+
+    ``python-telegram-bot`` advances its polling offset immediately after its
+    awaited ``update_queue.put`` calls complete.  Application handlers run
+    later in a different task, so handler-side persistence is too late for a
+    durable collector.  This queue consumes Business updates only after the
+    adapter's durable ingress callback succeeds; ordinary updates retain the
+    stock queue behaviour.
+
+    The synchronous ``put_nowait`` path is intentionally unavailable for a
+    guarded update so no future caller can bypass the durability boundary.
+    """
+
+    def __init__(
+        self,
+        *,
+        is_guarded: Callable[[object], bool],
+        durable_put: Callable[[object], Awaitable[None]],
+    ) -> None:
+        super().__init__()
+        self._is_guarded = is_guarded
+        self._durable_put = durable_put
+
+    async def put(self, item: object) -> None:
+        if self._is_guarded(item):
+            await self._durable_put(item)
+            # Deliberately do not enqueue: passive Business data may never
+            # reach broad group-0 assistant handlers. PTB may advance its
+            # offset now because durable_put returned only after local fsync.
+            return
+        await super().put(item)
+
+    def put_nowait(self, item: object) -> None:
+        if self._is_guarded(item):
+            raise RuntimeError(
+                "Telegram passive Business updates require awaited durable ingress"
+            )
+        super().put_nowait(item)
+
+
+def _build_single_update_polling_bot(**kwargs: Any) -> Any:
+    """Build an ExtBot whose polling batches contain at most one update.
+
+    PTB acknowledges a whole ``getUpdates`` batch only after queueing every
+    member. Without this bound, an ordinary owner DM earlier in the batch can
+    reach Hermes while a later Business update holds the durable queue barrier;
+    a restart would then redeliver and execute that DM twice. One update per
+    polling response preserves the pre-existing ordinary-DM semantics while
+    keeping the Business ACK boundary lossless. Webhook delivery is already
+    one update per HTTP request and is unaffected.
+    """
+
+    class _SingleUpdateExtBot(ExtBot):
+        async def get_updates(self, *args: Any, **call_kwargs: Any) -> Any:
+            call_kwargs["limit"] = 1
+            return await super().get_updates(*args, **call_kwargs)
+
+    return _SingleUpdateExtBot(**kwargs)
+
+
+def _build_passive_application_with_fresh_transport(
+    *,
+    bot_kwargs: dict[str, Any],
+    request_factory: Callable[[], tuple[Any, Any]],
+    update_queue: _DurableBusinessIngressQueue,
+) -> Any:
+    """Build one passive PTB app with a newly allocated request pair."""
+    request, get_updates_request = request_factory()
+    passive_bot = _build_single_update_polling_bot(
+        **bot_kwargs,
+        request=request,
+        get_updates_request=get_updates_request,
+    )
+    return (
+        Application.builder()
+        .bot(passive_bot)
+        .update_queue(update_queue)
+        .build()
+    )
