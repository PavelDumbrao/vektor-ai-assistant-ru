+    @staticmethod
+    def _business_connection_is_receive_only(connection: Any) -> bool:
+        """Accept only Business connections with every Telegram right disabled."""
+        _, rights_valid, receive_only, _reply_only = business_connection_rights_state(
+            getattr(connection, "rights", None)
+        )
+        return rights_valid and receive_only
+
+    def _business_connection_capture_authorized(self, connection: Any) -> bool:
+        """Validate metadata without coupling incoming capture to action rights."""
+        _, rights_valid, _receive_only, _reply_only = business_connection_rights_state(
+            getattr(connection, "rights", None)
+        )
+        return rights_valid
+
+    async def send_business_reply(
+        self,
+        *,
+        owner_id: int,
+        business_connection_id: str,
+        chat_id: int,
+        text: str,
+        reply_message_id: Optional[int] = None,
+    ) -> BusinessReplyResult:
+        """Send one exact Business reply after a fresh live rights check.
+
+        This method is intentionally absent from the platform tool registry.
+        The module-level bridge below is the only supported caller and binds it
+        to the active owner session plus an atomically consumed approval grant.
+        Failures before ``send_message`` are known non-sends; once that method
+        is invoked, any exception or invalid receipt is ambiguous and must not
+        be retried automatically.
+        """
+        if (
+            isinstance(owner_id, bool)
+            or not isinstance(owner_id, int)
+            or owner_id <= 0
+            or isinstance(chat_id, bool)
+            or not isinstance(chat_id, int)
+            or chat_id <= 0
+            or not isinstance(business_connection_id, str)
+            or not business_connection_id
+            or business_connection_id != business_connection_id.strip()
+            or len(business_connection_id) > 512
+            or any(ord(char) < 0x20 for char in business_connection_id)
+            or not isinstance(text, str)
+            or not text
+            or "\x00" in text
+            or utf16_len(text) > self.MAX_MESSAGE_LENGTH
+            or (
+                reply_message_id is not None
+                and (
+                    isinstance(reply_message_id, bool)
+                    or not isinstance(reply_message_id, int)
+                    or reply_message_id <= 0
+                )
+            )
+        ):
+            return BusinessReplyResult(
+                status="failed_known", error_code="invalid_send_arguments"
+            )
+
+        try:
+            if self._business_updates_mode() != "passive":
+                return BusinessReplyResult(
+                    status="failed_known", error_code="passive_mode_required"
+                )
+            if not self._business_reply_enabled():
+                return BusinessReplyResult(
+                    status="failed_known", error_code="business_reply_disabled"
+                )
+            if owner_id not in self._business_owner_ids():
+                return BusinessReplyResult(
+                    status="failed_known", error_code="owner_not_allowed"
+                )
+        except Exception:
+            return BusinessReplyResult(
+                status="failed_known", error_code="business_reply_config_invalid"
+            )
+
+        bot = self._bot
+        if bot is None:
+            return BusinessReplyResult(
+                status="failed_known", error_code="telegram_not_connected"
+            )
+        getter = getattr(bot, "get_business_connection", None)
+        if not callable(getter):
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_check_unavailable"
+            )
+
+        try:
+            connection = await asyncio.wait_for(
+                getter(
+                    business_connection_id,
+                    read_timeout=8.0,
+                    connect_timeout=5.0,
+                    pool_timeout=5.0,
+                ),
+                timeout=12.0,
+            )
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning(
+                "[%s] Telegram Business reply preflight failed (%s)",
+                self.name,
+                type(exc).__name__,
+            )
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_check_failed"
+            )
+
+        live_connection_id = str(getattr(connection, "id", "") or "")
+        if live_connection_id != business_connection_id:
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_mismatch"
+            )
+        if getattr(connection, "is_enabled", None) is not True:
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_disabled"
+            )
+        try:
+            live_owner_id = int(
+                getattr(getattr(connection, "user", None), "id", 0) or 0
+            )
+        except (TypeError, ValueError, OverflowError):
+            live_owner_id = 0
+        if live_owner_id != owner_id:
+            return BusinessReplyResult(
+                status="failed_known", error_code="connection_owner_mismatch"
+            )
+        _rights, rights_valid, _receive_only, reply_only = (
+            business_connection_rights_state(getattr(connection, "rights", None))
+        )
+        if not rights_valid or not reply_only:
+            return BusinessReplyResult(
+                status="failed_known", error_code="business_reply_rights_invalid"
+            )
+
+        send_kwargs: Dict[str, Any] = {
+            "chat_id": chat_id,
+            "text": text,
+            "business_connection_id": business_connection_id,
+            "read_timeout": 10.0,
+            "write_timeout": 10.0,
+            "connect_timeout": 5.0,
+            "pool_timeout": 5.0,
+        }
+        if reply_message_id is not None:
+            send_kwargs["reply_parameters"] = ReplyParameters(
+                message_id=reply_message_id,
+                allow_sending_without_reply=False,
+            )
+
+        try:
+            message = await bot.send_message(**send_kwargs)
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning(
+                "[%s] Telegram Business reply send outcome is ambiguous (%s)",
+                self.name,
+                type(exc).__name__,
+            )
+            return BusinessReplyResult(
+                status="ambiguous", error_code="telegram_send_exception"
+            )
+
+        message_id = getattr(message, "message_id", None)
+        if (
+            isinstance(message_id, bool)
+            or not isinstance(message_id, int)
+            or message_id <= 0
+        ):
+            return BusinessReplyResult(
+                status="ambiguous", error_code="invalid_send_receipt"
+            )
+        return BusinessReplyResult(status="sent", message_id=message_id)
+
+    def _authorize_business_update(self, update: Update) -> int | None:
+        """Resolve an allowlisted Business owner before persisting any chat PII."""
+        allowed = self._business_owner_ids()
+        kind = business_update_kind(update)
+        registry = self._get_passive_connection_registry()
+        if kind == "business_connection":
+            connection = update.business_connection
+            connection_id = str(getattr(connection, "id", "") or "").strip()
+            registry.mark_existing_untrusted(
+                connection_id,
+                int(getattr(update, "update_id", -1)),
+            )
+            owner_id = getattr(getattr(connection, "user", None), "id", None)
+            try:
+                owner_id = int(owner_id)
+            except (TypeError, ValueError, OverflowError):
+                return None
+            if owner_id not in allowed or not connection_id:
+                logger.warning(
+                    "[%s] Ignoring Telegram Business connection outside owner allowlist",
+                    self.name,
+                )
+                return None
+            enabled = getattr(connection, "is_enabled", None) is True
+            capture_authorized = self._business_connection_capture_authorized(
+                connection
+            )
+            registry.update(
+                connection_id,
+                owner_id,
+                enabled=enabled and capture_authorized,
+                update_id=int(getattr(update, "update_id", -1)),
+            )
+            if enabled and not capture_authorized:
+                logger.error(
+                    "[%s] Telegram Business connection rights metadata is invalid; "
+                    "message capture remains disabled",
+                    self.name,
+                )
+            return owner_id
+
+        source = (
+            update.deleted_business_messages
+            if kind == "deleted_business_messages"
+            else getattr(update, kind)
+        )
+        chat_type = str(getattr(getattr(source, "chat", None), "type", "") or "")
+        if chat_type != "private":
+            logger.warning(
+                "[%s] Ignoring non-private Telegram Business update: kind=%s update_id=%s",
+                self.name,
+                kind,
+                getattr(update, "update_id", None),
+            )
+            return None
+        connection_id = str(
+            getattr(source, "business_connection_id", "") or ""
+        ).strip()
+        owner_id = registry.owner_for(connection_id) if connection_id else None
+        if owner_id not in allowed:
+            logger.warning(
+                "[%s] Ignoring Telegram Business update for an unknown connection: "
+                "kind=%s update_id=%s",
+                self.name,
+                kind,
+                getattr(update, "update_id", None),
+            )
+            return None
+        return owner_id
+
+    async def _authorize_business_update_with_recovery(
+        self, update: Update
+    ) -> tuple[int | None, dict[str, Any] | None]:
+        """Resolve an owner and hydrate every message from authoritative state.
+
+        Telegram explicitly recommends ``getBusinessConnection`` when a bot
+        receives message updates before it has cached the corresponding
+        connection event.  The same live check is required while the local
+        registry is warm: registry durability is not proof that the downstream
+        PostgreSQL connection row committed.  Only the opaque connection id is
+        sent to Telegram; message content is not persisted until the returned
+        owner passes the deployment allowlist.  Lifecycle DTOs remain unchanged.
+        """
+        kind = business_update_kind(update)
+        if kind == "business_connection":
+            return self._authorize_business_update(update), None
+
+        source = (
+            update.deleted_business_messages
+            if kind == "deleted_business_messages"
+            else getattr(update, kind)
+        )
+        # This is a definitive scope rejection, not a cache miss. Never make a
+        # live capability query for a non-private payload.
+        chat_type = str(getattr(getattr(source, "chat", None), "type", "") or "")
+        if chat_type != "private":
+            logger.warning(
+                "[%s] Ignoring non-private Telegram Business update: "
+                "kind=%s update_id=%s",
+                self.name,
+                kind,
+                getattr(update, "update_id", None),
+            )
+            return None, None
+        connection_id = str(
+            getattr(source, "business_connection_id", "") or ""
+        ).strip()
+        getter = getattr(self._bot, "get_business_connection", None)
+        if not connection_id:
+            return None, None
+        if not callable(getter):
+            raise RuntimeError(
+                "Telegram Business connection recovery is temporarily unavailable"
+            )
+        try:
+            connection = await asyncio.wait_for(
+                getter(
+                    connection_id,
+                    read_timeout=8.0,
+                    connect_timeout=5.0,
+                    pool_timeout=5.0,
+                ),
+                timeout=12.0,
+            )
+            recovered_owner = int(
+                getattr(getattr(connection, "user", None), "id", 0) or 0
+            )
+            recovered_enabled = getattr(connection, "is_enabled", None) is True
+            recovered_capture_authorized = self._business_connection_capture_authorized(
+                connection
+            )
+        except asyncio.CancelledError:
+            raise
+        except Exception as exc:
+            logger.warning(
+                "[%s] Could not recover Telegram Business connection metadata; "
+                "durable ingress will retry (%s)",
+                self.name,
+                type(exc).__name__,
+            )
+            raise RuntimeError(
+                "Telegram Business connection recovery failed"
+            ) from exc
+        if not recovered_enabled:
+            logger.warning(
+                "[%s] Rejected disabled Telegram Business connection during recovery",
+                self.name,
+            )
+            return None, None
+        if not recovered_capture_authorized:
+            logger.error(
+                "[%s] Rejected Telegram Business connection with invalid "
+                "rights metadata during recovery",
+                self.name,
+            )
+            return None, None
+        if recovered_owner not in self._business_owner_ids():
+            logger.warning(
+                "[%s] Rejected recovered Telegram Business connection outside owner allowlist",
+                self.name,
+            )
+            return None, None
+        try:
+            connection_snapshot = normalize_recovered_business_connection_snapshot(
+                connection,
+                expected_connection_id=connection_id,
+                tenant_owner_id=recovered_owner,
+                business_reply_enabled=self._business_reply_enabled(),
+            )
+        except ValueError as exc:
+            logger.error(
+                "[%s] Rejected malformed Telegram Business connection recovery: %s",
+                self.name,
+                str(exc),
+            )
+            return None, None
+        accepted = self._get_passive_connection_registry().recover_current(
+            connection_id,
+            recovered_owner,
+            enabled=True,
+            observed_update_id=int(getattr(update, "update_id", -1)),
+        )
+        if not accepted:
+            return None, None
+        return recovered_owner, connection_snapshot
+
+    async def _ingest_passive_business_update_once(self, update: Update) -> bool:
+        """Persist one authorized Business update, or reject it definitively.
+
+        ``False`` means the update is safely outside the configured capture
+        scope. Exceptions mean the decision or fsync is indeterminate and the
+        Telegram offset must not advance.
+        """
+        owner_id, connection_snapshot = (
+            await self._authorize_business_update_with_recovery(update)
+        )
+        if owner_id is None:
+            return False
+        event = build_business_update_dto(
+            update,
+            tenant_owner_id=owner_id,
+            business_reply_enabled=self._business_reply_enabled(),
+            connection_snapshot=connection_snapshot,
+        )
+        self._get_passive_update_spool().put(event)
+        self._passive_spool_wakeup.set()
+        return True
+
+    async def _durably_ingest_business_update_before_ack(
+        self, update: Update
+    ) -> None:
+        """Hold PTB's acknowledgement boundary until local durability exists.
+
+        The retry loop intentionally lives inside ``Queue.put``. PTB only
+        catches Telegram transport exceptions around polling; leaking a local
+        disk/registry exception would kill its polling task while leaving the
+        updater marked running. Cancellation is the sole exception: shutdown
+        cancels this await and Telegram then redelivers from the old offset.
+        """
+        attempt = 0
+        self._passive_ingress_blocked = True
+        try:
+            while True:
+                try:
+                    await self._ingest_passive_business_update_once(update)
+                    return
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    attempt += 1
+                    if attempt == 1 or attempt & (attempt - 1) == 0:
+                        logger.critical(
+                            "[%s] Telegram Business durable ingress is blocked; "
+                            "offset not acknowledged, retry=%d kind=%s update_id=%s "
+                            "failure=%s",
+                            self.name,
+                            attempt,
+                            self._safe_business_update_kind(update),
+                            getattr(update, "update_id", None),
+                            type(exc).__name__,
+                        )
+                    await asyncio.sleep(
+                        self._passive_ingress_retry_delay_seconds(attempt)
+                    )
+        finally:
+            self._passive_ingress_blocked = False
+
+    async def _route_update_through_durable_ingress(self, item: object) -> None:
+        """Queue callback for an item identified as passive Business/group data."""
+        if self._ordinary_group_message(item) is not None:
+            await self._durably_ingest_group_update_before_ack(item)
+            return
+        await self._durably_ingest_business_update_before_ack(item)  # type: ignore[arg-type]
+
+    async def _ingest_passive_group_update_once(self, update: Update) -> bool:
+        message = self._ordinary_group_message(update)
+        if message is None:
+            return False
+        chat_id = int(getattr(getattr(message, "chat", None), "id", 0) or 0)
+        if chat_id not in self._group_passive_chat_ids():
+            return False
+        sender = getattr(message, "from_user", None)
+        if getattr(sender, "is_bot", False) is True:
+            return False
+        event = build_group_passive_update_dto(
+            update,
+            tenant_owner_id=self._group_passive_owner_id(),
+        )
+        self._get_passive_update_spool().put(event)
+        self._passive_spool_wakeup.set()
+        return True
+
+    async def _durably_ingest_group_update_before_ack(self, update: Update) -> None:
+        attempt = 0
+        self._passive_ingress_blocked = True
+        try:
+            while True:
+                try:
+                    await self._ingest_passive_group_update_once(update)
+                    return
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    attempt += 1
+                    if attempt == 1 or attempt & (attempt - 1) == 0:
+                        logger.critical(
+                            "[%s] Telegram group durable ingress blocked; offset not "
+                            "acknowledged retry=%d update_id=%s failure=%s",
+                            self.name, attempt, getattr(update, "update_id", None),
+                            type(exc).__name__,
+                        )
+                    await asyncio.sleep(self._passive_ingress_retry_delay_seconds(attempt))
+        finally:
+            self._passive_ingress_blocked = False
+
+    def _dispatch_passive_event(self, event: dict[str, Any]) -> bool:
+        """Offer one durable DTO to plugins and acknowledge only after commit."""
+        from hermes_cli.lifecycle import invoke_hook as _invoke_hook
+
+        raw_results = _invoke_hook("telegram_passive_update", event=event)
+        hook_results = raw_results if isinstance(raw_results, (list, tuple)) else []
+        acknowledged = any(
+            isinstance(result, dict) and result.get("handled") is True
+            for result in hook_results
+        )
+        if acknowledged:
+            if (
+                self._passive_media_enabled()
+                and event.get("kind")
+                in {
+                    "business_message", "edited_business_message",
+                    "group_message", "edited_group_message",
+                }
+            ):
+                # This is part of the raw-spool ACK barrier.  A plugin/PG
+                # commit is not enough for media messages: the private job
+                # (the only durable copy retaining file_id) must also fsync.
+                self._get_passive_media_spool().stage_event(
+                    event,
+                    bot_id=self._passive_media_bot_id(),
+                    processor_version=self._passive_media_processor_version(),
+                )
+            self._get_passive_update_spool().acknowledge(event)
+            return True
+        logger.critical(
+            "[%s] Telegram passive update is durable but collector did not "
+            "acknowledge it: kind=%s update_id=%s",
+            self.name,
+            event.get("kind"),
+            event.get("update_id"),
+        )
+        return False
+
+    def _drain_passive_update_spool(self) -> int:
+        drained = 0
+        for event in self._get_passive_update_spool().pending(limit=250):
+            try:
+                if not self._dispatch_passive_event(event):
+                    break
+                drained += 1
+            except Exception as exc:
+                logger.error(
+                    "[%s] Telegram passive replay failed; pending data retained (%s)",
+                    self.name,
+                    type(exc).__name__,
+                )
+                break
+        return drained
+
+    async def _passive_spool_retry_loop(self) -> None:
+        interval = self._coerce_float_extra(
+            "passive_retry_seconds", 30.0, min_value=5.0, max_value=3600.0
+        )
+        try:
+            while True:
+                self._passive_spool_wakeup.clear()
+                # PostgreSQL/plugin work is deliberately kept off PTB's event
+                # loop. Telegram can continue polling once the local fsync
+                # spool has accepted an event.
+                try:
+                    await asyncio.to_thread(self._drain_passive_update_spool)
+                except Exception as exc:
+                    logger.error(
+                        "[%s] Telegram passive replay loop failed; retrying later (%s)",
+                        self.name,
+                        type(exc).__name__,
+                    )
+                try:
+                    await asyncio.wait_for(
+                        self._passive_spool_wakeup.wait(), timeout=interval
+                    )
+                except asyncio.TimeoutError:
+                    pass
+        except asyncio.CancelledError:
+            raise
+
+    def _start_passive_spool_retry(self) -> None:
+        if (
+            self._business_updates_mode() != "passive"
+            and not self._group_passive_enabled()
+        ):
+            return
+        task = self._passive_spool_retry_task
+        if task and not task.done():
+            return
+        self._passive_spool_retry_task = asyncio.ensure_future(
+            self._passive_spool_retry_loop()
+        )
+
+    def _passive_media_processor_identity(self) -> dict[str, str]:
+        if self._passive_media_asr_provider() == "openrouter":
+            return {
+                "service": "openrouter",
+                "version": "v1",
+                "engine": "openrouter-stt",
+                "model": "openai/whisper-large-v3-turbo",
+                "quantization": "provider-managed",
+            }
+        return {
+            "service": "whisper-asr-webservice",
+            "version": "1.9.1",
+            "engine": "faster-whisper",
+            "model": "small",
+            "quantization": "int8",
+        }
+
+    @staticmethod
+    def _passive_media_download_is_permanent(error: BaseException) -> bool:
+        try:
+            from telegram.error import BadRequest
+
+            return isinstance(error, BadRequest)
+        except ImportError:
+            return False
+
+    def _dispatch_passive_media_result(self, event: dict[str, Any]) -> bool:
+        """Commit one capability-free media result through the existing hook."""
+        from hermes_cli.lifecycle import invoke_hook as _invoke_hook
+
+        raw_results = _invoke_hook("telegram_passive_update", event=event)
+        hook_results = raw_results if isinstance(raw_results, (list, tuple)) else []
+        handled = any(
+            isinstance(result, dict) and result.get("handled") is True
+            for result in hook_results
+        )
+        if handled:
+            self._get_passive_media_spool().acknowledge_result(event)
+            return True
+        logger.critical(
+            "[%s] Telegram passive media result retained; collector did not acknowledge it",
+            self.name,
+        )
+        return False
+
+    async def _process_passive_media_job(self, job: dict[str, Any]) -> bool:
+        """Process one job serially with the already-running PTB Bot instance."""
+        spool = self._get_passive_media_spool()
+        temp_path: Optional[_Path] = None
+        try:
+            if job.get("processor_version") != self._passive_media_processor_version():
+                logger.error(
+                    "[%s] Telegram passive media job retained after processor change",
+                    self.name,
+                )
+                return False
+            status = job.get("preflight_status")
+            transcription = None
+            if status is None:
+                bot = self._bot
+                if bot is None:
+                    raise MediaTransientError("telegram_not_connected")
+                try:
+                    telegram_file = await asyncio.wait_for(
+                        bot.get_file(
+                            job["file_id"],
+                            read_timeout=15.0,
+                            connect_timeout=5.0,
+                            pool_timeout=5.0,
+                        ),
+                        timeout=20.0,
+                    )
+                    reported_size = getattr(telegram_file, "file_size", None)
+                    if (
+                        isinstance(reported_size, int)
+                        and not isinstance(reported_size, bool)
+                        and reported_size > MAX_MEDIA_FILE_BYTES
+                    ):
+                        raise MediaPermanentError("too_large")
+                    temp_path = spool.create_private_temp(job["job_id"])
+                    await asyncio.wait_for(
+                        telegram_file.download_to_drive(
+                            custom_path=temp_path,
+                            read_timeout=60.0,
+                            write_timeout=60.0,
+                            connect_timeout=5.0,
+                            pool_timeout=5.0,
+                        ),
+                        timeout=90.0,
+                    )
+                except asyncio.CancelledError:
+                    raise
+                except MediaPermanentError:
+                    raise
+                except Exception as exc:
+                    if self._passive_media_download_is_permanent(exc):
+                        raise MediaPermanentError(
+                            "download_failed_permanent"
+                        ) from exc
+                    raise MediaTransientError("download_failed") from exc
+                try:
+                    info = temp_path.stat()
+                except OSError as exc:
+                    raise MediaTransientError("download_temp_unavailable") from exc
+                if not 0 < info.st_size <= MAX_MEDIA_FILE_BYTES:
+                    raise MediaPermanentError("too_large")
+                transcription = await self._get_passive_media_asr().transcribe(
+                    temp_path,
+                    media_kind=job["media_kind"],
+                )
+                status = "transcribed"
+
+            result = build_media_result_event(
+                job,
+                status=str(status),
+                processor=self._passive_media_processor_identity(),
+                transcript=(transcription.transcript if transcription else None),
+                language=(transcription.language if transcription else None),
+                content_sha256=(
+                    transcription.content_sha256 if transcription else None
+                ),
+                actual_bytes=(transcription.actual_bytes if transcription else None),
+                duration_ms=(transcription.duration_ms if transcription else None),
+            )
+            # Result fsync precedes job ACK.  Startup reconciliation closes the
+            # crash window between these two operations without retranscribing.
+            spool.put_result(result)
+            spool.acknowledge_job(job)
+            return True
+        except asyncio.CancelledError:
+            raise
+        except MediaPermanentError as exc:
+            result = build_media_result_event(
+                job,
+                status=exc.status,
+                processor=self._passive_media_processor_identity(),
+            )
+            spool.put_result(result)
+            spool.acknowledge_job(job)
+            return True
+        except MediaTransientError:
+            logger.warning(
+                "[%s] Telegram passive media job retained after transient failure",
+                self.name,
+            )
+            return False
+        except Exception as exc:
+            logger.error(
+                "[%s] Telegram passive media job retained after %s",
+                self.name,
+                type(exc).__name__,
+            )
+            return False
+        finally:
+            if temp_path is not None:
+                try:
+                    spool.discard_private_temp(temp_path)
+                except Exception as exc:
+                    logger.error(
+                        "[%s] Telegram passive media temp cleanup failed (%s)",
+                        self.name,
+                        type(exc).__name__,
+                    )
+
+    async def _passive_media_worker_loop(self) -> None:
+        """Single-concurrency media worker; never owns another Telegram poller."""
+        interval = self._coerce_float_extra(
+            "passive_media_retry_seconds",
+            30.0,
+            min_value=5.0,
+            max_value=300.0,
+        )
+        spool = self._get_passive_media_spool()
+        try:
+            while True:
+                try:
+                    await asyncio.to_thread(spool.cleanup_private_temps)
+                    await asyncio.to_thread(spool.reconcile_completed_jobs)
+                    results = await asyncio.to_thread(
+                        spool.pending_results, limit=25
+                    )
+                    result_blocked = False
+                    for result in results:
+                        handled = await asyncio.to_thread(
+                            self._dispatch_passive_media_result, result
+                        )
+                        if not handled:
+                            result_blocked = True
+                            break
+                    if not result_blocked:
+                        # A transient first job must not starve later media.
+                        # The loop remains strictly serial (concurrency=1),
+                        # but advances through one bounded batch per interval.
+                        jobs = await self._process_passive_media_batch(
+                            spool, limit=10
+                        )
+                        if jobs:
+                            completed = await asyncio.to_thread(
+                                spool.pending_results, limit=25
+                            )
+                            for result in completed:
+                                handled = await asyncio.to_thread(
+                                    self._dispatch_passive_media_result,
+                                    result,
+                                )
+                                if not handled:
+                                    break
+                except asyncio.CancelledError:
+                    raise
+                except Exception as exc:
+                    logger.error(
+                        "[%s] Telegram passive media worker retrying after %s",
+                        self.name,
+                        type(exc).__name__,
+                    )
+                await asyncio.sleep(interval)
+        except asyncio.CancelledError:
+            raise
+
+    async def _process_passive_media_batch(
+        self, spool: DurableMediaSpool, *, limit: int
+    ) -> list[dict[str, Any]]:
+        """Advance a bounded serial batch even when one item is retryable."""
+        jobs = await asyncio.to_thread(
+            spool.pending_jobs, limit=max(1, min(int(limit), 25))
+        )
+        for job in jobs:
+            await self._process_passive_media_job(job)
+        return jobs
+
+    def _start_passive_media_worker(self) -> None:
+        if (
+            self._business_updates_mode() != "passive"
+            and not self._group_passive_enabled()
+        ):
+            return
+        if not self._passive_media_enabled():
+            return
+        task = self._passive_media_worker_task
+        if task and not task.done():
+            return
+        # Construction is the startup preflight for private spool permissions
+        # and the selected ASR provider credential.
+        self._get_passive_media_spool()
+        self._get_passive_media_asr()
+        self._passive_media_worker_task = asyncio.ensure_future(
+            self._passive_media_worker_loop()
+        )
+
+    async def _handle_business_update(
+        self,
+        update: Update,
+        context: ContextTypes.DEFAULT_TYPE,
+    ) -> None:
+        """Offer one Business update to plugins, then stop normal dispatch.
+
+        The callback intentionally receives only a capability-free JSON DTO —
+        never the PTB object, adapter, bot client, or token.  The core spool is
+        committed before the hook runs, so a collector/DB outage cannot lose
+        an update that Telegram already delivered.
+        """
+        mode = self._business_updates_mode()
+        if mode == "off":
+            return
+        if mode == "blocked":
+            raise ApplicationHandlerStop
+
+        try:
+            # Polling and webhook ingress normally consume Business updates in
+            # the guarded queue before they can reach this handler. Keep this
+            # path as defense-in-depth for direct Application.process_update()
+            # callers and tests; such injected updates have no Telegram ACK.
+            await self._ingest_passive_business_update_once(update)
+        except ApplicationHandlerStop:
+            raise
+        except Exception as exc:
+            logger.error(
+                "[%s] Telegram passive capture failed closed: "
+                "kind=%s update_id=%s failure=%s",
+                self.name,
+                self._safe_business_update_kind(update),
+                getattr(update, "update_id", None),
+                type(exc).__name__,
+            )
+
+        # Passive mode is fail-closed: even a missing/broken collector may not
+        # turn someone else's private chat into an Hermes assistant prompt.
+        raise ApplicationHandlerStop
+
+    async def _handle_passive_group_update(
+        self, update: Update, context: ContextTypes.DEFAULT_TYPE
+    ) -> None:
+        """Defense-in-depth route for directly injected ordinary group updates."""
+        if not self._group_passive_enabled():
+            return
+        try:
+            await self._ingest_passive_group_update_once(update)
+        except Exception as exc:
+            logger.error(
+                "[%s] Telegram passive group capture failed closed: update_id=%s failure=%s",
+                self.name, getattr(update, "update_id", None), type(exc).__name__,
+            )
+        raise ApplicationHandlerStop
+
+    async def _handle_passive_group_membership(
+        self, update: Update, context: ContextTypes.DEFAULT_TYPE
+    ) -> None:
+        """Ask the configured owner to opt a newly joined group into capture."""
+        if not self._group_passive_enabled():
+            return
+        membership = getattr(update, "my_chat_member", None)
+        chat = getattr(membership, "chat", None)
+        chat_type = str(getattr(chat, "type", "") or "")
+        if membership is None or chat_type not in {"group", "supergroup"}:
+            return
+        chat_id = int(getattr(chat, "id", 0) or 0)
+        if chat_id >= 0:
+            return
+        owner_id = self._group_passive_owner_id()
+        registry = self._get_passive_group_registry()
+        was_present = self._chat_member_is_present(
+            getattr(membership, "old_chat_member", None)
+        )
+        is_present = self._chat_member_is_present(
+            getattr(membership, "new_chat_member", None)
+        )
+        if was_present == is_present:
+            return
+
+        if not is_present:
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            return
+
+        actor_id = int(getattr(getattr(membership, "from_user", None), "id", 0) or 0)
+        if actor_id != owner_id:
+            # This is a personal assistant: another group member cannot enroll
+            # it on the owner's behalf.  Persist denial before the network call
+            # so even a failed leave cannot expose group content.
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            if self._bot is not None:
+                try:
+                    await self._bot.leave_chat(chat_id=chat_id)
+                except Exception as exc:
+                    logger.warning(
+                        "[%s] Could not leave owner-unauthorized Telegram group: %s",
+                        self.name, type(exc).__name__,
+                    )
+            return
+
+        title, username = self._group_consent_label(chat)
+        nonce = registry.begin(
+            chat_id=chat_id,
+            owner_id=owner_id,
+            title=title,
+            username=username,
+        )
+        suffix = f" (@{_html.escape(username)})" if username else ""
+        text = (
+            "🎧 <b>Подключить пассивного секретаря?</b>\n\n"
+            f"Группа: <b>{_html.escape(title)}</b>{suffix}\n\n"
+            "После подтверждения я буду сохранять только новые сообщения. "
+            "Голосовые и кружки расшифрую, у документов сохраню только метаданные. "
+            "В самой группе отвечать не буду."
+        )
+        keyboard = InlineKeyboardMarkup(
+            [
+                [InlineKeyboardButton(
+                    "✅ Да, подключить", callback_data=f"pg:y:{nonce}"
+                )],
+                [InlineKeyboardButton(
+                    "❌ Нет", callback_data=f"pg:n:{nonce}"
+                )],
+            ]
+        )
+        if self._bot is None:
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            return
+        try:
+            await self._bot.send_message(
+                chat_id=owner_id,
+                text=text,
+                parse_mode=ParseMode.HTML,
+                reply_markup=keyboard,
+            )
+        except Exception as exc:
+            registry.revoke(chat_id=chat_id, owner_id=owner_id)
+            try:
+                await self._bot.leave_chat(chat_id=chat_id)
+            except Exception:
+                pass
+            logger.warning(
+                "[%s] Passive group consent DM failed closed: %s",
+                self.name, type(exc).__name__,
+            )
+
+    async def _handle_passive_group_consent_callback(
+        self, update: Update, context: ContextTypes.DEFAULT_TYPE
+    ) -> None:
+        query = getattr(update, "callback_query", None)
+        data = getattr(query, "data", None)
+        if query is None or not isinstance(data, str):
+            return
+        parts = data.split(":", 2)
+        if len(parts) != 3 or parts[0] != "pg" or parts[1] not in {"y", "n"}:
+            await query.answer(text="Некорректное подтверждение.")
+            return
+        owner_id = self._group_passive_owner_id()
+        caller_id = int(getattr(getattr(query, "from_user", None), "id", 0) or 0)
+        message = getattr(query, "message", None)
+        callback_chat = getattr(message, "chat", None)
+        callback_chat_id = int(getattr(callback_chat, "id", 0) or 0)
+        callback_chat_type = str(getattr(callback_chat, "type", "") or "")
+        if (
+            caller_id != owner_id
+            or callback_chat_id != owner_id
+            or callback_chat_type != "private"
+        ):
+            await query.answer(text="⛔ Подтвердить может только владелец бота.")
+            return
+
+        approve = parts[1] == "y"
+        record = self._get_passive_group_registry().resolve(
+            nonce=parts[2], owner_id=owner_id, approve=approve
+        )
+        if record is None:
+            await query.answer(text="⌛ Запрос истёк или уже обработан.")
+            return
+        title = _html.escape(str(record.get("title") or "Группа Telegram"))
+        chat_id = int(record["chat_id"])
+        if approve:
+            answer = "✅ Группа подключена"
+            rendered = (
+                f"✅ <b>{title}</b> подключена к пассивному секретарю.\n\n"
+                "Сохраняются только новые сообщения после этого подтверждения. "
+                "В группе бот остаётся молчаливым."
+            )
+        else:
+            answer = "❌ Группа не подключена"
+            rendered = f"❌ <b>{title}</b> не подключена. Бот выходит из группы."
+            if self._bot is not None:
+                try:
+                    await self._bot.leave_chat(chat_id=chat_id)
+                except Exception as exc:
+                    logger.warning(
+                        "[%s] Passive group leave after denial failed: %s",
+                        self.name, type(exc).__name__,
+                    )
+        await query.answer(text=answer)
+        try:
+            await query.edit_message_text(
+                text=rendered,
+                parse_mode=ParseMode.HTML,
+                reply_markup=None,
+            )
+        except Exception:
+            pass
+
+    @staticmethod
+    def _safe_business_update_kind(update: Update) -> str:
+        try:
+            return business_update_kind(update)
+        except Exception:
+            return "unknown"
+
+    def _register_application_handlers(self, app: Application) -> None:
+        """Register PTB handlers in deterministic routing priority order."""
+        # Validate the literal bool before any polling/webhook handlers can be
+        # registered. Strings and integers must not silently widen capture.
+        self._business_reply_enabled()
+        business_mode = self._business_updates_mode()
+        group_passive = self._group_passive_enabled()
+        if group_passive:
+            self._group_passive_chat_ids()
+            self._group_passive_owner_id()
+            self._get_passive_group_registry()
+            self._get_passive_update_spool()
+            if self._passive_media_enabled():
+                self._get_passive_media_spool()
+        if business_mode in {"blocked", "passive"}:
+            if any(
+                dependency is None
+                for dependency in (
+                    ApplicationHandlerStop,
+                    BusinessConnectionHandler,
+                    BusinessMessagesDeletedHandler,
+                )
+            ):
+                raise RuntimeError(
+                    "Telegram passive mode requires python-telegram-bot >= 21.1"
+                )
+            if business_mode == "passive":
+                self._business_owner_ids()
+                # Startup preflight: passive mode must not begin consuming
+                # updates unless its fsync-backed local inbox is usable.
+                self._get_passive_update_spool()
+                if self._passive_media_enabled():
+                    # Opt-in only.  Raw passive capture remains independent
+                    # and fully available while this literal flag is false.
+                    self._get_passive_media_spool()
