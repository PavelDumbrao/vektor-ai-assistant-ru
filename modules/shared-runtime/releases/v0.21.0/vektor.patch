+
+    def _passive_media_asr_provider(self) -> str:
+        raw = (self.config.extra or {}).get("passive_media_asr_provider", "local")
+        if not isinstance(raw, str) or raw != raw.strip().lower():
+            raise ValueError(
+                "Telegram passive_media_asr_provider must be 'local' or 'openrouter'"
+            )
+        if raw not in {"local", "openrouter"}:
+            raise ValueError(
+                "Telegram passive_media_asr_provider must be 'local' or 'openrouter'"
