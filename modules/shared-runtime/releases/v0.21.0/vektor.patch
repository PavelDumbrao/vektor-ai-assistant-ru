+    chat_id: int,
+    text: str,
+    reply_message_id: Optional[int] = None,
+) -> BusinessReplyResult:
+    """Consume one exact grant and bridge the send onto the gateway loop."""
+    try:
+        from tools.approval import (
+            consume_one_time_approval_grant,
+            get_current_session_key,
+        )
+    except Exception:
+        return BusinessReplyResult(
+            status="failed_known", error_code="approval_bridge_unavailable"
+        )
+
+    session_key = get_current_session_key(default="")
+    try:
+        if isinstance(owner_id, bool):
+            raise ValueError
+        parsed_owner_id = int(owner_id)
+    except (TypeError, ValueError, OverflowError):
+        parsed_owner_id = 0
+    if (
+        not session_key
+        or parsed_owner_id <= 0
+        or not isinstance(approval_key, str)
+        or not approval_key
+        or len(approval_key) > 512
+        or any(char.isspace() or ord(char) < 0x20 for char in approval_key)
+        or not isinstance(business_connection_id, str)
+        or not business_connection_id
+        or business_connection_id != business_connection_id.strip()
+        or len(business_connection_id) > 512
+        or any(ord(char) < 0x20 for char in business_connection_id)
+        or isinstance(chat_id, bool)
+        or not isinstance(chat_id, int)
+        or chat_id <= 0
+        or not isinstance(text, str)
+        or not text
+        or "\x00" in text
+        or (
+            reply_message_id is not None
