+        )
+    except Exception:
+        return BusinessReplyResult(
+            status="ambiguous", error_code="send_bridge_exception"
+        )
+    if not isinstance(result, BusinessReplyResult):
+        return BusinessReplyResult(
+            status="ambiguous", error_code="invalid_bridge_result"
+        )
+    if result.status not in {"sent", "failed_known", "ambiguous"}:
+        return BusinessReplyResult(
+            status="ambiguous", error_code="invalid_bridge_result"
+        )
