+                groups[str(chat_id)] = ({
+                    key: value
+                    for key, value in (record or {}).items()
+                    if key not in {"nonce_sha256", "expires_at"}
+                } or {"owner_id": owner_id, "title": "Группа Telegram"})
+                groups[str(chat_id)]["state"] = "denied"
+                self._write_locked(groups)
+                return True
