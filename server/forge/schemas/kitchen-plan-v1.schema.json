{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-forge:schema:kitchen-plan:v1",
  "title": "Hermes Forge Kitchen Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "catalog_sha256", "plan_sha256", "agent",
    "effective_runtime", "models", "memory", "selected_optional",
    "capabilities", "permissions", "health", "onboarding"
  ],
  "properties": {
    "schema": {"const": "hermes.kitchen-plan/v1"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "effective_runtime": {"type": "string", "pattern": "^>=0\\.[0-9]+,<0\\.[0-9]+$"},
    "agent": {"$ref": "#/$defs/agent"},
    "models": {"$ref": "#/$defs/models"},
    "memory": {"$ref": "#/$defs/memory"},
    "selected_optional": {
      "type": "array", "uniqueItems": true, "maxItems": 32,
      "items": {"$ref": "#/$defs/id"}
    },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {"$ref": "#/$defs/capability"}
    },
    "permissions": {"$ref": "#/$defs/agentPermissions"},
    "health": {
      "type": "object", "additionalProperties": false,
      "required": ["suite"],
      "properties": {"suite": {"enum": ["personal-hermes-smoke-v1"]}}
    },
    "onboarding": {
      "type": "object", "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "questions": {
          "type": "array", "uniqueItems": true, "maxItems": 20,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,79}$"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "agent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "publisher", "role", "summary"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 80},
        "role": {"$ref": "#/$defs/id"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "models": {
      "type": "object", "additionalProperties": false,
      "required": ["primary", "fallback"],
      "properties": {
        "primary": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,79}$"},
        "fallback": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{1,79}$"}
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "required": ["passive_secretary"],
      "properties": {"passive_secretary": {"type": "boolean"}}
    },
    "capability": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "name", "version", "publisher", "trust_tier", "required",
        "kind", "summary", "runtime", "connection", "permissions",
        "execution", "retention", "metering"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 80},
        "trust_tier": {"enum": ["official", "verified", "community"]},
        "required": {"type": "boolean"},
        "kind": {"enum": ["builtin", "connector", "mcp", "plugin", "shared_tool"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 240},
        "runtime": {"type": "string", "pattern": "^>=0\\.[0-9]+,<0\\.[0-9]+$"},
        "connection": {"$ref": "#/$defs/connection"},
        "permissions": {"$ref": "#/$defs/capabilityPermissions"},
        "execution": {"$ref": "#/$defs/execution"},
        "retention": {"enum": ["none", "tenant_private", "platform_aggregate"]},
        "metering": {"enum": ["none", "provider_usage", "platform_usage"]}
      }
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "secret_names", "oauth_scopes"],
      "properties": {
        "mode": {"enum": ["none", "personal_secret", "platform", "oauth", "telegram"]},
        "secret_names": {
          "type": "array", "uniqueItems": true, "maxItems": 8,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"}
        },
        "oauth_scopes": {
          "type": "array", "uniqueItems": true, "maxItems": 24,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "capabilityPermissions": {
      "type": "object", "additionalProperties": false,
      "required": ["network", "filesystem", "action_default"],
      "properties": {
        "network": {"enum": ["none", "platform", "external_api"]},
        "filesystem": {"enum": ["none", "tenant_config", "tenant_workspace", "shared_runtime"]},
        "action_default": {"$ref": "#/$defs/policy"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["install", "uninstall", "health_operation"],
      "properties": {
        "install": {
          "enum": ["none", "ensure-maton", "ensure-telegram-secretary", "noop", "ensure-image-studio", "ensure-video-editor"]
        },
        "uninstall": {
          "enum": ["none", "disable-maton", "disable-telegram-secretary", "disable-image-studio", "disable-video-editor"]
        },
        "health_operation": {
          "enum": ["none", "maton-connections", "telegram-secretary-ready", "web-search-ready", "image-studio-ready", "video-editor-ready"]
        }
      }
    },
    "agentPermissions": {
      "type": "object", "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]{1,79}$"},
      "additionalProperties": {"$ref": "#/$defs/policy"}
    },
    "policy": {
      "enum": ["observe", "approval", "autonomous", "owner_only", "disabled"]
    }
  }
}
