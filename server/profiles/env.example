# Copy into a PRIVATE profile .env and supply values there. Never commit that file.
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_ALLOWED_USERS=<owner-id>,<optional-technician-id>
LLM_API_KEY=<primary-provider-key>
FALLBACK_LLM_API_KEY=<fallback-provider-key>
MCP_MATON_API_KEY=<owner-maton-key>
TAVILY_API_KEY=<search-key>
OPENROUTER_API_KEY=<speech-recognition-key>
MINIMAX_API_KEY=<optional-tts-key>
HERMES_DOC_WORKSPACE=/home/<owner>/workspace
HERMES_DOC_AUTHOR=<document-author>
# Written by the existing PostgreSQL provisioner:
PASSIVE_SECRETARY_DATABASE_URL=<private-database-dsn>
PASSIVE_SECRETARY_SOURCE_REF_KEY=<private-source-reference-key>
