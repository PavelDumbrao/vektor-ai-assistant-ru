# Sanitized configuration template; replace OWNER_TELEGRAM_USER_ID before use.
model:
  provider: custom
  base_url: https://lingsuan.top/v1
  default: gpt-5.6-sol
  api_key: ${LLM_API_KEY}
  context_length: 500000
fallback_providers:
- provider: custom
  model: gpt-5.6-sol
  base_url: https://gengruihuan.cn/v1
  key_env: FALLBACK_LLM_API_KEY
image_gen:
  provider: grsai
  model: gpt-image-2.5
max_concurrent_sessions: 2
max_live_sessions: 4
agent:
  max_turns: 60
  api_max_retries: 1
  gateway_timeout: 1800
  verbose: false
  reasoning_effort: medium
  disabled_toolsets:
  - browser-cdp
  - computer_use
  - delegation
  - discord
  - discord_admin
  - feishu_doc
  - feishu_drive
  - homeassistant
  - project
  - terminal
  - video
  - video_gen
  - passive_secretary_outbound
terminal:
  backend: local
  cwd: /home/pavel/workspace
  timeout: 180
  home_mode: auto
approvals:
  mode: smart
  timeout: 300
  cron_mode: deny
  deny:
  - rm -rf /*
  - git push --force*
command_allowlist: []
skills:
  guard_agent_created: true
  write_approval: true
curator:
  enabled: true
  consolidate: true
  prune_builtins: false
kanban:
  dispatch_in_gateway: false
memory:
  memory_enabled: true
  user_profile_enabled: true
  write_approval: true
  memory_char_limit: 4000
  user_char_limit: 6000
  provider: ''
tts:
  provider: minimax
  edge:
    voice: ru-RU-DmitryNeural
    max_text_length: 800
  minimax:
    model: speech-2.8-turbo
    voice_id: Russian_ReliableMan
    speed: 1.15
    vol: 1.0
    pitch: 0
    emotion: neutral
    sample_rate: 44100
    bitrate: 128000
stt:
  enabled: true
  provider: openrouter_whisper
  language: ru
  local:
    model: base
    language: ru
    vad: true
  openrouter:
    model: openai/whisper-large-v3-turbo
voice:
  auto_tts: false
search:
  provider: tavily
web:
  search_backend: tavily
  extract_backend: tavily
timezone: Europe/Moscow
display:
  language: ru
  busy_input_mode: queue
  busy_ack_enabled: true
  platforms:
    telegram:
      streaming: true
      tool_progress: all
      tool_progress_grouping: accumulate
      interim_assistant_messages: false
      thinking_progress: false
      long_running_notifications: generic
      cleanup_progress: true
gateway:
  delivery_ledger: true
  platform_connect_timeout: 60
platforms:
  telegram:
    enabled: true
    unauthorized_dm_behavior: ignore
    home_channel:
      platform: telegram
      chat_id: OWNER_TELEGRAM_USER_ID
      name: Owner
    extra:
      allow_admin_from:
      - OWNER_TELEGRAM_USER_ID
      user_allowed_commands:
      - start
      - help
      - maton
      - status
      - new
      - reset
      - retry
      - undo
      - title
      - resume
      - sessions
      - usage
      - voice
      - memory
      - context
      - compress
      - whoami
      command_menu:
        max_commands: 16
        priority_mode: replace
        priority:
        - help
        - maton
        - new
        - status
        - resume
        - sessions
        - retry
        - undo
        - title
        - context
        - compress
        - usage
        - voice
        - memory
        - whoami
      business_updates_mode: passive
      business_owner_ids:
      - OWNER_TELEGRAM_USER_ID
      business_reply_enabled: false
      passive_media_enabled: true
      passive_media_asr_provider: openrouter
      group_passive_enabled: false
      group_passive_chat_ids: []
network:
  force_ipv4: true
logging:
  level: INFO
  max_size_mb: 5
  backup_count: 3
updates:
  pre_update_backup: quick
  backup_keep: 5
  non_interactive_local_changes: stash
plugins:
  enabled:
  - ai_fixer
  - passive-secretary
  - focus_assistant
  - image_gen/grsai
  - video-editor
  disabled: []
goals:
  max_turns: 5
_config_version: 33
mcp_servers:
  maton:
    enabled: true
    url: https://mcp.maton.ai
    headers:
      Authorization: Bearer ${MCP_MATON_API_KEY}
    connect_timeout: 60
    tools:
      include:
      - whoami
      - search_apps
      - search_actions
      - get_action
      - create_connection
      - get_connection
      - list_connections
      - run_action
onboarding:
  seen:
    busy_input_prompt: true
    profile_build_offered: true
hooks:
  post_tool_call:
  - command: /usr/local/bin/hermes-clean-docmeta
    timeout: 30
hooks_auto_accept: true
streaming:
  mode: auto
  edit_interval: 1.2
  buffer_threshold: 24
  cursor: ''
  fresh_final_after_seconds: 20
  waiting_status:
    enabled: true
    initial_delay: 0.5
    update_interval: 2.0
    elapsed_after: 4.0
    phrases:
    - ⏳ Думаю
    - ⌛ Разбираюсь
auxiliary:
  curator:
    provider: custom
    model: gpt-5.6-terra
    timeout: 600
    reasoning_effort: high
    extra_body:
      reasoning_effort: high
